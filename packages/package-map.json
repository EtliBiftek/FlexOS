{
  "flexos-base": {
    "description": "FlexOS distribution identity and base integration",
    "depends": "bash, systemd",
    "paths": ["etc/flexos-release","etc/apt/apt.conf.d/99flexos-identity","usr/bin/flexos-info","usr/lib/flexos/flex-identity-apply","usr/lib/systemd/system/flexos-identity.service","usr/share/flexos/identity.json","usr/share/flexos/identity","usr/share/flexos/release-info","usr/share/doc/flexos"]
  },
  "flexos-branding": {
    "description": "FlexOS GRUB, icon, wallpaper and desktop branding",
    "depends": "flexos-base, grub-common",
    "paths": ["boot/grub/themes/flexos","etc/default/grub.d/60-flexos.cfg","etc/sddm.conf.d/10-flexos.conf","usr/lib/flexos/flex-branding-apply","usr/share/icons/hicolor/scalable/apps/flexos-logo.svg","usr/share/pixmaps/flexos-logo.svg","usr/share/sddm/themes/breeze/theme.conf.user","usr/share/wallpapers/FlexOS","usr/share/flexos/skel/FlexOS.profile","usr/share/flexos/skel/konsolerc","usr/share/flexos/skel/klipperrc","etc/xdg/menus/applications-merged/flexos.menu","usr/share/desktop-directories/flexos.directory"]
  },
  "flexos-center": {
    "description": "Flex Center graphical system management application",
    "depends": "flexos-base, flexos-tools, flexos-performance, flexos-gaming, python3, python3-pyqt6, pkexec",
    "paths": ["usr/bin/flex-center","usr/share/applications/flex-center.desktop","usr/share/flexos/apps.json"]
  },
  "flexos-welcome": {
    "description": "Flex Welcome first-run setup experience",

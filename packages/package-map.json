    "paths": ["usr/bin/flex","usr/bin/flex-session-launch","usr/bin/flex-system-report","usr/bin/flex-beta-check","usr/bin/flex-self-update","usr/bin/flex-hwd","usr/bin/flex-mirror","usr/bin/flex-repo","usr/bin/flex-secureboot","usr/bin/flex-kernel-manager","usr/bin/flex-regdomain","usr/bin/flex-pci-latency","usr/bin/flex-topmem","usr/bin/flex-zink-run","usr/bin/flex-dlss-run","usr/lib/flexos/flex-admin","usr/lib/flexos/flexsuite.py","usr/lib/flexos/flexcachy.py","usr/lib/flexos/flexlib.py","usr/lib/flexos/flex-package-profile-install","usr/lib/flexos/flex-profile-apply","usr/lib/flexos/flex-snapshot-pre","usr/lib/flexos/flex-snapshot-post","usr/lib/flexos/flex-recovery-console","usr/lib/flexos/flex-postinstall","usr/lib/flexos/flex-desktop-install","usr/lib/flexos/flex-hyprdots-install","usr/lib/flexos/flex-privileged-session","usr/lib/flexos/session-bin","usr/lib/systemd/system/flexos-profile.service","usr/lib/systemd/system/flexos-recovery.target","usr/lib/systemd/system/flexos-recovery.service","usr/lib/systemd/system/flexos-ci-smoke.service","usr/lib/systemd/system/flexos-regdomain.service","usr/lib/systemd/system/flexos-pci-latency.service","etc/apt/apt.conf.d/80flexos-snapshot","etc/grub.d/41_flexos_recovery","etc/kernel/postinst.d/zz-flexos-sign-kernel","usr/share/bash-completion/completions/flex","usr/share/applications/flex-recovery.desktop","usr/share/applications/flex-system-report.desktop","usr/share/flexos/package-profiles.json","usr/share/flexos/desktop-profiles.json","usr/share/flexos/optimized-repos.json","usr/share/flexos/kernel-variants.json"]
  },
  "flexos-performance": {
    "description": "FlexOS CachyOS-inspired kernel, sched_ext and process-priority performance policy",
    "depends": "flexos-base, python3, systemd, procps, kmod, systemd-zram-generator, power-profiles-daemon",
    "paths": ["etc/systemd/zram-generator.conf","etc/sysctl.d/70-flexos-performance.conf","etc/systemd/system.conf.d/70-flexos-performance.conf","etc/systemd/user.conf.d/70-flexos-performance.conf","etc/systemd/journald.conf.d/70-flexos-performance.conf","usr/lib/flexos/flex-performance-apply","usr/lib/flexos/flex-scx-profile-sync","usr/lib/systemd/system/flexos-performance.service","usr/lib/systemd/system/flexos-scx-profile-sync.service","usr/lib/systemd/system/flexos-scx-profile-sync.timer","usr/bin/flex-kernel-info","usr/bin/flex-game-performance","usr/bin/flex-performance-config","usr/bin/flex-scx","usr/bin/flex-ananicy"]
  },
  "flexos-gaming": {
    "description": "FlexOS gaming stack manager for Steam, Gamescope, umu and Proton-CachyOS",
    "depends": "flexos-base, flexos-tools, flexos-performance, python3, curl, ca-certificates, flatpak, xz-utils",
    "paths": ["usr/bin/flex-gaming"]
  },
  "flexos-calamares": {
    "description": "FlexOS Calamares installer integration and branding",
    "depends": "flexos-base, flexos-tools, calamares, calamares-settings-debian, squashfs-tools, cracklib-runtime",
    "paths": ["usr/share/flexos/calamares/modules/mount.conf","usr/bin/flexos-installer","usr/share/applications/flexos-installer.desktop","usr/share/flexos/calamares/branding","usr/share/flexos/calamares/modules/packagechooser-desktop.conf","usr/share/flexos/calamares/modules/packagechooser-hyprdots.conf","usr/share/flexos/calamares/modules/contextualprocess-flexdesktop.conf","usr/share/flexos/calamares/modules/contextualprocess-hyprdots.conf","usr/share/flexos/calamares/modules/packagechooser-flexpackages.conf","usr/share/flexos/calamares/modules/contextualprocess-flexpackages.conf","usr/share/flexos/calamares/modules/shellprocess-flexpostinstall.conf","usr/share/flexos/calamares/modules/welcome.conf","usr/share/flexos/calamares/modules/locale.conf","usr/share/flexos/calamares/modules/keyboard.conf","etc/flexos/calamares-root-config"]
  },
  "flexos-plymouth": {
    "description": "FlexOS Plymouth boot splash",
    "depends": "flexos-branding, plymouth, initramfs-tools",
    "paths": ["usr/share/plymouth/themes/flexos"]
  }
}

#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, os, socket, subprocess, sys
from pathlib import Path

ALLOWED = {
    "/usr/lib/flexos/flex-admin",
    "/usr/lib/flexos/flex-package-profile-install",
    "/usr/bin/flex",
    "/usr/bin/flex-hwd",
    "/usr/bin/flex-mirror",
    "/usr/bin/flex-repo",
    "/usr/bin/flex-scx",
    "/usr/bin/flex-ananicy",
    "/usr/bin/flex-performance-config",
    "/usr/bin/flex-gaming",
    "/usr/bin/flex-kernel-manager",
    "/usr/bin/flex-secureboot",
}

def send(conn,obj):
    conn.sendall((json.dumps(obj,ensure_ascii=False)+"\n").encode())

def peer_uid(conn):
    if hasattr(socket,"SO_PEERCRED"):
        raw=conn.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12)
        return int.from_bytes(raw[4:8],sys.byteorder)
    return None

ap=argparse.ArgumentParser()
ap.add_argument("--socket",required=True)
ap.add_argument("--uid",required=True,type=int)
args=ap.parse_args()

if os.geteuid()!=0:
    raise SystemExit("flex-privileged-session must run as root")

sock_path=Path(args.socket)
runtime=sock_path.parent.resolve()
expected=Path(f"/run/user/{args.uid}")
if runtime != expected or sock_path.name.startswith(".") or "/" in sock_path.name:
    raise SystemExit("Unsafe privileged session socket path")
runtime.mkdir(parents=True,exist_ok=True)
if sock_path.exists():
    sock_path.unlink()

server=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
server.bind(str(sock_path))
os.chown(sock_path,args.uid,-1)
os.chmod(sock_path,0o600)
server.listen(4)
print("FLEXOS_PRIV_READY",flush=True)

try:
    running=True
    while running:
        conn,_=server.accept()
        with conn:
            uid=peer_uid(conn)
            if uid is not None and uid!=args.uid:
                send(conn,{"type":"done","code":126,"message":"Unauthorized client."})
                continue
            raw=b""
            while b"\n" not in raw and len(raw)<1024*1024:
                chunk=conn.recv(65536)
                if not chunk:break
                raw+=chunk
            try:req=json.loads(raw.split(b"\n",1)[0] or b"{}")
            except Exception:
                send(conn,{"type":"done","code":64,"message":"Invalid request."});continue
            if req.get("op")=="quit":
                send(conn,{"type":"done","code":0})
                running=False
                continue
            command=req.get("command")
            if not isinstance(command,list) or not command or not all(isinstance(x,str) for x in command):
                send(conn,{"type":"done","code":64,"message":"Malformed command."});continue
            if command[0] not in ALLOWED:
                send(conn,{"type":"done","code":126,"message":f"Command is not allowed: {command[0]}"});continue
            try:
                proc=subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1)
                assert proc.stdout is not None
                for line in proc.stdout:
                    send(conn,{"type":"out","data":line.rstrip("\n")})
                send(conn,{"type":"done","code":proc.wait()})
            except Exception as exc:
                send(conn,{"type":"done","code":127,"message":str(exc)})
finally:
    server.close()
    try:sock_path.unlink()
    except FileNotFoundError:pass

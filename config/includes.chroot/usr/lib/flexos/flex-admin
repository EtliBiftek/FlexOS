#!/usr/bin/env python3
from __future__ import annotations
import os, re, shutil, subprocess, sys
from pathlib import Path

LOG=Path("/var/log/flexos-admin.log")

def log(msg):
    try:
        LOG.parent.mkdir(parents=True,exist_ok=True)
        with LOG.open("a",encoding="utf-8") as f:
            f.write(msg.rstrip()+"\n")
    except Exception:
        pass

def run(cmd, check=True, timeout=None):
    printable="+ "+" ".join(map(str,cmd))
    print(printable,flush=True);log(printable)
    p=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout)
    if p.stdout:
        print(p.stdout,end="" if p.stdout.endswith("\n") else "\n")
        log(p.stdout)
    if check and p.returncode:
        raise SystemExit(p.returncode)
    return p.returncode,p.stdout or ""

def require_root():
    if os.geteuid()!=0:
        raise SystemExit("Administrator privileges required.")

def apt_update():
    run(["apt-get","update"],timeout=600)

def mark_reboot(reason):
    p=Path("/run/flexos-reboot-required")
    p.parent.mkdir(parents=True,exist_ok=True)
    p.write_text(reason.strip()+"\n",encoding="utf-8")

def root_is_btrfs():
    rc,out=run(["findmnt","-n","-o","FSTYPE","/"],check=False,timeout=10)
    return rc==0 and out.strip()=="btrfs"

def btrfs_root_is_subvolume():
    if not root_is_btrfs():
        return False
    rc,out=run(["findmnt","-n","-o","FSROOT","/"],check=False,timeout=10)
    return rc==0 and out.strip() not in ("","/")

def snapper_ready():
    return Path("/etc/snapper/configs/root").exists()

def pre_snapshot(desc):
    if btrfs_root_is_subvolume() and snapper_ready() and shutil.which("snapper"):
        run(["snapper","-c","root","create","--description",desc],check=False,timeout=120)

def set_grub_key(key,value):
    p=Path("/etc/default/grub.d/70-flexos-user.cfg")
    p.parent.mkdir(parents=True,exist_ok=True)
    lines=p.read_text(errors="ignore").splitlines() if p.exists() else []
    lines=[x for x in lines if not x.startswith(key+"=")]
    lines.append(f'{key}="{value}"')
    p.write_text("\n".join(lines)+"\n",encoding="utf-8")

def ensure_nonfree():
    changed=False
    for p in Path("/etc/apt/sources.list.d").glob("*.sources"):
        text=p.read_text(errors="ignore");out=[]
        local=False
        for line in text.splitlines():
            if line.startswith("Components:"):
                comps=line.split(":",1)[1].split()
                for c in ("main","contrib","non-free","non-free-firmware"):
                    if c not in comps:
                        comps.append(c);local=True
                line="Components: "+" ".join(comps)
            out.append(line)
        if local:
            p.write_text("\n".join(out)+"\n",encoding="utf-8");changed=True
    p=Path("/etc/apt/sources.list")
    if p.exists():
        out=[];local=False
        for line in p.read_text(errors="ignore").splitlines():
            if line.strip().startswith("deb ") and not line.lstrip().startswith("#"):
                parts=line.split()
                for c in ("contrib","non-free","non-free-firmware"):
                    if c not in parts:
                        parts.append(c);local=True
                line=" ".join(parts)
            out.append(line)
        if local:
            p.write_text("\n".join(out)+"\n",encoding="utf-8");changed=True
    return changed

def remove_nvidia():
    pre_snapshot("Before NVIDIA driver removal")
    # Purge only Debian NVIDIA driver packages. Do not use wildcards through shell.
    rc,out=run(["dpkg-query","-W","-f=${binary:Package}\n"],check=False,timeout=30)
    candidates=[]
    for pkg in out.splitlines():
        base=pkg.split(":",1)[0]
        if (
            base=="nvidia-driver" or base=="nvidia-settings" or
            base.startswith("nvidia-kernel-") or base.startswith("nvidia-driver-") or
            base.startswith("libnvidia-") or base.startswith("xserver-xorg-video-nvidia")
        ):
            candidates.append(pkg)
    if candidates:
        run(["apt-get","purge","-y",*sorted(set(candidates))],check=False,timeout=2400)
        run(["apt-get","autoremove","-y"],check=False,timeout=1200)
    for p in (
        Path("/etc/X11/xorg.conf"),
        Path("/etc/modprobe.d/nvidia.conf"),
        Path("/etc/modprobe.d/nvidia-blacklists-nouveau.conf"),
    ):
        p.unlink(missing_ok=True)
    run(["update-initramfs","-u","-k","all"],check=False,timeout=1200)
    run(["update-grub"],check=False,timeout=300)
    mark_reboot("NVIDIA driver removal")
    print("NVIDIA proprietary driver removal completed. Reboot recommended.")

def enable_flexos_repo():
    key_url="https://etlibiftek.github.io/FlexOS/flexos-archive-keyring.asc"
    repo_url="https://etlibiftek.github.io/FlexOS"
    key=Path("/etc/apt/keyrings/flexos-archive-keyring.asc")
    key.parent.mkdir(parents=True,exist_ok=True)
    run(["curl","-fL","--connect-timeout","10","--max-time","30","-o",str(key),key_url],timeout=45)
    source=Path("/etc/apt/sources.list.d/flexos.sources")
    source.write_text(
        "Types: deb\n"
        f"URIs: {repo_url}\n"
        "Suites: beta\n"
        "Components: main\n"
        f"Signed-By: {key}\n",
        encoding="utf-8"
    )
    apt_update()
    print("FlexOS signed APT repository enabled.")

def install_component_update(directory, filenames):
    base=Path(directory).resolve()
    if not str(base).startswith("/tmp/flexos-update-"):
        raise SystemExit("Refusing component update outside a FlexOS temporary directory.")
    debs=[]
    for name in filenames:
        if "/" in name or not re.fullmatch(r"flexos-[A-Za-z0-9.+~_-]+\.deb",name):
            raise SystemExit(f"Invalid update package filename: {name}")
        p=(base/name).resolve()
        if p.parent!=base or not p.exists():
            raise SystemExit(f"Missing update package: {name}")
        debs.append(str(p))
    if not debs:
        print("No FlexOS component packages need updating.")
        return
    pre_snapshot("Before FlexOS component update")
    rc,_=run(["dpkg","-i",*debs],check=False,timeout=1200)
    if rc:
        apt_update()
        run(["apt-get","-f","install","-y"],timeout=1800)
        run(["dpkg","-i",*debs],timeout=1200)
    run(["systemctl","daemon-reload"],check=False,timeout=30)
    run(["update-initramfs","-u","-k","all"],check=False,timeout=1200)
    run(["update-grub"],check=False,timeout=300)
    print("FlexOS component update completed. Restart affected applications; reboot if boot/driver components changed.")

require_root()
args=sys.argv[1:]
if not args:
    raise SystemExit("No action")
group=args[0]
action=args[1] if len(args)>1 else ""

if group=="update":
    if action=="refresh":
        apt_update()
    elif action=="install":
        pre_snapshot("Before FlexOS system update")
        apt_update()
        run(["apt-get","dist-upgrade","-y"],timeout=3600)
    else:
        raise SystemExit(2)

elif group=="driver":
    if action=="nvidia":
        if shutil.which("mokutil"):
            rc,sb=run(["mokutil","--sb-state"],check=False,timeout=20)
            if rc==0 and "enabled" in sb.lower():
                raise SystemExit(
                    "Secure Boot is enabled. FlexOS 0.5 Beta does not automate NVIDIA DKMS/MOK "
                    "enrollment yet, so automatic proprietary NVIDIA installation is refused to "
                    "avoid an unbootable or black-screen graphics state. Disable Secure Boot for "
                    "this beta test or use a manually signed Debian NVIDIA module workflow."
                )
        ensure_nonfree()
        pre_snapshot("Before NVIDIA driver installation")
        apt_update()
        run(["apt-get","install","-y","linux-headers-amd64","nvidia-driver","nvidia-settings"],timeout=3600)
        run(["update-initramfs","-u","-k","all"],check=False,timeout=1200)
        mark_reboot("NVIDIA driver installation")
        print("NVIDIA driver installed. Reboot recommended.")
    elif action=="nvidia-remove":
        remove_nvidia()
    else:
        raise SystemExit(2)

elif group=="snapshot":
    if action=="setup":
        if not root_is_btrfs():
            raise SystemExit("Root filesystem is not Btrfs.")
        if not btrfs_root_is_subvolume():
            raise SystemExit("Btrfs root is mounted from the top-level volume; safe FlexOS rollback requires a root subvolume.")
        if not snapper_ready():
            run(["snapper","-c","root","create-config","/"],timeout=120)
        print("Snapper root configuration ready.")
    elif action=="create":
        if not snapper_ready():
            raise SystemExit("Setup snapshots first.")
        desc=" ".join(args[2:]) or "FlexOS manual snapshot"
        run(["snapper","-c","root","create","--description",desc],timeout=120)
    elif action=="list":
        run(["snapper","-c","root","list"],timeout=60)
    elif action=="delete":
        run(["snapper","-c","root","delete",args[2]],timeout=120)
    elif action=="rollback":
        if not btrfs_root_is_subvolume() or not snapper_ready():
            raise SystemExit("Rollback unavailable: Btrfs root subvolume + Snapper are required.")
        run(["snapper","-c","root","rollback",args[2]],timeout=300)
        run(["update-grub"],check=False,timeout=300)
        print("Rollback prepared. Reboot required.")
    else:
        raise SystemExit(2)

elif group=="performance":
    if action=="zram":
        state=args[2]
        p=Path("/etc/systemd/zram-generator.conf")
        if state=="on":
            p.write_text("[zram0]\nzram-size = min(ram / 2, 8192)\ncompression-algorithm = zstd\n",encoding="utf-8")
        elif state=="off":
            p.unlink(missing_ok=True)
        else:
            raise SystemExit(2)
        run(["systemctl","daemon-reload"],check=False,timeout=30)
        mark_reboot("zRAM configuration change")
        print("zRAM configuration changed. Reboot recommended.")
    elif action=="swappiness":
        val=int(args[2])
        if not 1<=val<=100:
            raise SystemExit("Swappiness must be between 1 and 100.")
        Path("/etc/sysctl.d/90-flexos-performance.conf").write_text(f"vm.swappiness={val}\n",encoding="utf-8")
        run(["sysctl","-p","/etc/sysctl.d/90-flexos-performance.conf"],check=False,timeout=30)
    else:
        raise SystemExit(2)

elif group=="cleanup":
    if action=="system":
        pre_snapshot("Before Flex Cleanup")
        run(["apt-get","autoremove","-y"],check=False,timeout=1200)
        run(["apt-get","clean"],check=False,timeout=60)
        run(["journalctl","--vacuum-time=7d"],check=False,timeout=60)
    else:
        raise SystemExit(2)

elif group=="boot":
    if action=="timeout":
        n=int(args[2])
        if not 0<=n<=30:
            raise SystemExit("GRUB timeout must be between 0 and 30.")
        set_grub_key("GRUB_TIMEOUT",str(n))
        set_grub_key("GRUB_TIMEOUT_STYLE","menu" if n else "hidden")
        run(["update-grub"],timeout=300)
    elif action=="quiet":
        state=args[2]
        set_grub_key("GRUB_CMDLINE_LINUX_DEFAULT","quiet splash" if state=="on" else "")
        run(["update-grub"],timeout=300)
    else:
        raise SystemExit(2)

elif group=="kernel":
    if action=="backports":
        Path("/etc/apt/sources.list.d/flexos-trixie-backports.sources").write_text(
            "Types: deb\n"
            "URIs: http://deb.debian.org/debian\n"
            "Suites: trixie-backports\n"
            "Components: main contrib non-free non-free-firmware\n"
            "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg\n",
            encoding="utf-8"
        )
        pre_snapshot("Before backports kernel")
        apt_update()
        run(["apt-get","install","-y","-t","trixie-backports","linux-image-amd64","linux-headers-amd64"],timeout=3600)
        run(["update-grub"],check=False,timeout=300)
        mark_reboot("Kernel installation")
        print("Backports kernel installed. Reboot to use it.")
    else:
        raise SystemExit(2)

elif group=="repair":
    if action=="dpkg":
        run(["dpkg","--configure","-a"],timeout=1200)
    elif action=="packages":
        apt_update()
        run(["apt-get","-f","install","-y"],timeout=1800)
    elif action=="apt":
        shutil.rmtree("/var/lib/apt/lists",ignore_errors=True)
        Path("/var/lib/apt/lists").mkdir(parents=True,exist_ok=True)
        apt_update()
    elif action=="initramfs":
        run(["update-initramfs","-u","-k","all"],timeout=1200)
    elif action=="grub":
        run(["update-grub"],timeout=300)
    elif action=="network":
        run(["systemctl","restart","NetworkManager"],timeout=60)
    else:
        raise SystemExit(2)

elif group=="security":
    if action=="firewall":
        state=args[2]
        if state=="on":
            run(["ufw","default","deny","incoming"],check=False)
            run(["ufw","default","allow","outgoing"],check=False)
            run(["ufw","--force","enable"])
        elif state=="off":
            run(["ufw","--force","disable"])
        else:
            raise SystemExit(2)
    elif action=="autoupdates":
        state=args[2]
        p=Path("/etc/apt/apt.conf.d/20auto-upgrades")
        if state=="on":
            p.write_text(
                'APT::Periodic::Update-Package-Lists "1";\n'
                'APT::Periodic::Unattended-Upgrade "1";\n',
                encoding="utf-8"
            )
            run(["systemctl","enable","--now","unattended-upgrades.service"],check=False,timeout=60)
        elif state=="off":
            p.unlink(missing_ok=True)
            run(["systemctl","disable","--now","unattended-upgrades.service"],check=False,timeout=60)
        else:
            raise SystemExit(2)
    elif action=="coredumps":
        state=args[2]
        p=Path("/etc/systemd/coredump.conf.d/90-flexos-privacy.conf")
        p.parent.mkdir(parents=True,exist_ok=True)
        if state=="off":
            p.write_text("[Coredump]\nStorage=none\nProcessSizeMax=0\n",encoding="utf-8")
        elif state=="on":
            p.unlink(missing_ok=True)
        else:
            raise SystemExit(2)
    elif action=="location":
        state=args[2]
        if state=="on":
            run(["systemctl","unmask","geoclue.service"],check=False,timeout=30)
        elif state=="off":
            run(["systemctl","mask","geoclue.service"],check=False,timeout=30)
            run(["systemctl","stop","geoclue.service"],check=False,timeout=30)
        else:
            raise SystemExit(2)
    else:
        raise SystemExit(2)

elif group=="app":
    if action=="apt":
        pkg=args[2]
        if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]*",pkg):
            raise SystemExit("Invalid package name.")
        pre_snapshot("Before app installation")
        apt_update()
        run(["apt-get","install","-y",pkg],timeout=3600)
    else:
        raise SystemExit(2)

elif group=="repo":
    if action=="enable":
        enable_flexos_repo()
    elif action=="disable":
        Path("/etc/apt/sources.list.d/flexos.sources").unlink(missing_ok=True)
        print("FlexOS APT repository disabled.")
    else:
        raise SystemExit(2)

elif group=="flexupdate":
    if action!="install" or len(args)<3:
        raise SystemExit(2)
    install_component_update(args[2],args[3:])

else:
    raise SystemExit("Unknown action")

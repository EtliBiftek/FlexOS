#!/usr/bin/env python3
from __future__ import annotations
import os, re, subprocess
from pathlib import Path

if os.geteuid()!=0:
    raise SystemExit("flex-postinstall must run as root")

def run(cmd, timeout=180):
    try:
        return subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=timeout)
    except Exception:
        return None

def remove_live_autologin():
    p=Path("/etc/sddm.conf.d/10-flexos.conf")
    if not p.exists():
        return
    lines=p.read_text(errors="ignore").splitlines()
    out=[]; skipping=False
    for line in lines:
        if line.strip()=="[Autologin]":
            skipping=True
            continue
        if skipping and line.startswith("[") and line.endswith("]"):
            skipping=False
        if not skipping:
            out.append(line)
    p.write_text("\n".join(out).rstrip()+"\n",encoding="utf-8")

def configure_snapper():
    fs=run(["findmnt","-n","-o","FSTYPE","/"])
    if not fs or fs.returncode or fs.stdout.strip()!="btrfs":
        return "not-btrfs"
    fsroot=run(["findmnt","-n","-o","FSROOT","/"])
    if not fsroot or fsroot.returncode or fsroot.stdout.strip() in ("","/"):
        return "btrfs-top-level-no-rollback"
    cfg=Path("/etc/snapper/configs/root")
    if not cfg.exists():
        run(["snapper","-c","root","create-config","/"],120)
    if not cfg.exists():
        return "setup-failed"
    text=cfg.read_text(errors="ignore")
    desired={
        "TIMELINE_CREATE":'"yes"',
        "TIMELINE_CLEANUP":'"yes"',
        "NUMBER_CLEANUP":'"yes"',
        "NUMBER_LIMIT":'"10"',
        "NUMBER_LIMIT_IMPORTANT":'"5"',
        "TIMELINE_LIMIT_HOURLY":'"5"',
        "TIMELINE_LIMIT_DAILY":'"7"',
        "TIMELINE_LIMIT_WEEKLY":'"2"',
        "TIMELINE_LIMIT_MONTHLY":'"2"',
        "TIMELINE_LIMIT_YEARLY":'"0"',
    }
    for key,val in desired.items():
        pattern=re.compile(rf"^{re.escape(key)}=.*$",re.M)
        if pattern.search(text):
            text=pattern.sub(f"{key}={val}",text)
        else:
            text+=f"\n{key}={val}"
    cfg.write_text(text.rstrip()+"\n",encoding="utf-8")
    return "ready"

Path("/etc/flexos").mkdir(parents=True,exist_ok=True)
Path("/etc/flexos/desktop-profile").write_text("kde\n",encoding="utf-8")
Path("/etc/flexos/desktop-profile-status").write_text("installed\n",encoding="utf-8")

remove_live_autologin()
snap=configure_snapper()

boot="UEFI" if Path("/sys/firmware/efi").exists() else "BIOS"
fs=run(["findmnt","-n","-o","FSTYPE","/"])
fstype=fs.stdout.strip() if fs and fs.returncode==0 else "unknown"
Path("/etc/flexos/install-info").write_text(
    f"desktop=KDE Plasma\nboot={boot}\nfilesystem={fstype}\nsnapshot={snap}\n",
    encoding="utf-8"
)

for unit in ("NetworkManager.service","sddm.service","flexos-profile.service","flexos-identity.service","ufw.service"):
    run(["systemctl","enable",unit],30)

run(["systemctl","set-default","graphical.target"],30)
run(["update-initramfs","-u","-k","all"],600)
run(["update-grub"],180)
print(f"FlexOS post-install complete: filesystem={fstype}, snapper={snap}, boot={boot}")

#!/bin/sh
set -u

[ "$(findmnt -n -o FSTYPE / 2>/dev/null)" = "btrfs" ] || exit 0
[ -f /etc/snapper/configs/root ] || exit 0
command -v snapper >/dev/null 2>&1 || exit 0

state=/run/flexos-package-snapshot-pre
stamp=/run/flexos-last-package-snapshot
now="$(date +%s)"
last=0
[ -r "$stamp" ] && last="$(cat "$stamp" 2>/dev/null || printf 0)"
case "$last" in *[!0-9]*|"") last=0 ;; esac

# A high-level APT operation can invoke dpkg more than once. Reuse the current
# pre snapshot until its matching post hook closes the transaction.
if [ -r "$state" ] && [ $((now-last)) -lt 60 ]; then
    exit 0
fi

pre="$(snapper -c root create --type pre --cleanup-algorithm number --print-number \
    --description "Before package transaction" 2>/dev/null || \
    snapper -c root create --type pre --print-number \
    --description "Before package transaction" 2>/dev/null || true)"
case "$pre" in *[!0-9]*|"") exit 0 ;; esac

mkdir -p /run
printf '%s\n' "$pre" > "$state" 2>/dev/null || true
printf '%s\n' "$now" > "$stamp" 2>/dev/null || true
exit 0

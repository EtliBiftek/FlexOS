#!/usr/bin/env python3
from __future__ import annotations
import json,os,subprocess,sys
from pathlib import Path

if os.geteuid()!=0:
    raise SystemExit("root required")

strict="--strict" in sys.argv
names=[x for x in sys.argv[1:] if not x.startswith("--")]
name=names[0] if names else "standard"

data=json.loads(Path("/usr/share/flexos/package-profiles.json").read_text())
if name not in data:
    raise SystemExit(f"Unknown package profile: {name}")

pkgs=data[name].get("packages",[])
state=Path("/etc/flexos")
state.mkdir(parents=True,exist_ok=True)
(state/"package-profile").write_text(name+"\n",encoding="utf-8")
pending=state/"package-profile-pending"
pending.unlink(missing_ok=True)

if not pkgs:
    print(f"Package profile {name}: no additional packages required.")
    raise SystemExit(0)

def fail_or_defer(message,code):
    pending.write_text(name+"\n",encoding="utf-8")
    print(message)
    print("The base FlexOS installation remains usable. Reapply this profile later from Flex Center.")
    raise SystemExit(code if strict else 0)

p=subprocess.run(["apt-get","update"])
if p.returncode:
    fail_or_defer("Package index could not be refreshed, likely because the network is unavailable.",20)

p=subprocess.run(["apt-get","install","-y","--no-install-recommends",*pkgs])
if p.returncode:
    fail_or_defer("Some package-profile packages could not be installed.",21)

pending.unlink(missing_ok=True)
print(f"Flex Package Profile '{name}' installed.")

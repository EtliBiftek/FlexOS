#!/usr/bin/env python3
import json, os, subprocess, sys
from pathlib import Path

DATA = Path("/usr/share/flexos/package-profiles.json")
STAMP = Path("/var/lib/flexos/apt-updated")

def run(cmd):
    print("+", " ".join(cmd))
    return subprocess.run(cmd).returncode

if os.geteuid() != 0:
    print("root required", file=sys.stderr); raise SystemExit(1)
profiles = json.loads(DATA.read_text())
name = sys.argv[1] if len(sys.argv) > 1 else ""
if name not in profiles:
    print(f"Unknown package profile: {name}", file=sys.stderr); raise SystemExit(2)
pkgs = profiles[name].get("packages", [])
Path("/etc/flexos").mkdir(parents=True, exist_ok=True)
Path("/etc/flexos/package-profile").write_text(name + "\n")
if not pkgs:
    print(f"Flex Package Profile '{name}' selected; no additional packages required.")
    raise SystemExit(0)
STAMP.parent.mkdir(parents=True, exist_ok=True)
if not STAMP.exists():
    if run(["apt-get","update"]) != 0:
        print("Package profile needs a working internet connection.", file=sys.stderr); raise SystemExit(20)
    STAMP.touch()
cmd = ["apt-get","install","-y","--no-install-recommends"] + pkgs
raise SystemExit(run(cmd))

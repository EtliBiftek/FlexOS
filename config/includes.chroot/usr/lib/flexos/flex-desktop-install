#!/usr/bin/env python3
import json, os, re, subprocess, sys
from pathlib import Path

DATA = Path("/usr/share/flexos/desktop-profiles.json")
STAMP = Path("/var/lib/flexos/apt-updated")

def run(cmd):
    print("+", " ".join(cmd))
    return subprocess.run(cmd).returncode

def clean_live_autologin():
    p = Path("/etc/sddm.conf.d/10-flexos.conf")
    if not p.exists():
        return
    lines = p.read_text(errors="ignore").splitlines()
    out, skipping = [], False
    for line in lines:
        if line.strip() == "[Autologin]":
            skipping = True
            continue
        if skipping and line.startswith("[") and line.endswith("]"):
            skipping = False
        if not skipping:
            out.append(line)
    p.write_text("\n".join(out).rstrip() + "\n")

def find_session(patterns):
    roots = [Path("/usr/share/wayland-sessions"), Path("/usr/share/xsessions")]
    for pattern in patterns:
        for root in roots:
            p = root / pattern
            if p.exists():
                return str(p)
    return ""

def normal_user():
    for line in Path("/etc/passwd").read_text().splitlines():
        parts = line.split(":")
        if len(parts) < 7: continue
        user, uid, home, shell = parts[0], int(parts[2]), parts[5], parts[6]
        if 1000 <= uid < 60000 and user != "flex" and home.startswith("/home/") and "nologin" not in shell:
            return user
    return ""

def set_sddm_last(session):
    if not session: return
    user = normal_user()
    Path("/var/lib/sddm").mkdir(parents=True, exist_ok=True)
    content = "[Last]\n"
    if user:
        content += f"User={user}\n"
    content += f"Session={Path(session).name}\n"
    Path("/var/lib/sddm/state.conf").write_text(content)

if os.geteuid() != 0:
    print("root required", file=sys.stderr); raise SystemExit(1)

profiles = json.loads(DATA.read_text())
name = sys.argv[1] if len(sys.argv) > 1 else ""
if name not in profiles:
    print(f"Unknown desktop profile: {name}", file=sys.stderr); raise SystemExit(2)

p = profiles[name]
status = p.get("status", "")
Path("/etc/flexos").mkdir(parents=True, exist_ok=True)
Path("/etc/flexos/desktop-profile").write_text(name + "\n")
clean_live_autologin()

if status == "experimental-pending":
    optional = p.get("packages", [])
    if optional:
        STAMP.parent.mkdir(parents=True, exist_ok=True)
        if not STAMP.exists() and run(["apt-get","update"]) == 0:
            STAMP.touch()
        if STAMP.exists():
            run(["apt-get","install","-y","--no-install-recommends"] + optional)
    Path("/etc/flexos/desktop-profile-status").write_text(
        "experimental-pending: complete desktop stack unavailable; KDE fallback retained\n"
    )
    set_sddm_last("/usr/share/wayland-sessions/plasma.desktop")
    print("Experimental desktop recorded. KDE remains the fallback.")
    raise SystemExit(0)

if status == "backports-network":
    src = Path("/etc/apt/sources.list.d/flexos-trixie-backports.sources")
    src.write_text("""Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main contrib non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
""")
    STAMP.unlink(missing_ok=True)

pkgs = p.get("packages", [])
if pkgs:
    STAMP.parent.mkdir(parents=True, exist_ok=True)
    if not STAMP.exists():
        if run(["apt-get","update"]) != 0:
            print(f"{p.get('name',name)} requires internet during installation.", file=sys.stderr)
            raise SystemExit(20)
        STAMP.touch()
    cmd = ["apt-get","install","-y","--no-install-recommends"]
    if status == "backports-network":
        cmd += ["-t","trixie-backports"]
    cmd += pkgs
    if run(cmd) != 0:
        raise SystemExit(21)

session = find_session(p.get("session_patterns", []))
if not session and name == "kde":
    session = "/usr/share/wayland-sessions/plasma.desktop"
set_sddm_last(session)
Path("/etc/flexos/desktop-profile-status").write_text("installed\n")
print(f"Desktop profile '{name}' installed.")

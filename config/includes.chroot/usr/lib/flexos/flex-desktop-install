#!/usr/bin/env python3
import os, sys
from pathlib import Path

if os.geteuid() != 0:
    print("root required", file=sys.stderr)
    raise SystemExit(1)

name = sys.argv[1] if len(sys.argv) > 1 else "kde"
if name != "kde":
    print("FlexOS supports KDE Plasma only.", file=sys.stderr)
    raise SystemExit(2)

Path("/etc/flexos").mkdir(parents=True, exist_ok=True)
Path("/etc/flexos/desktop-profile").write_text("kde\n", encoding="utf-8")
Path("/etc/flexos/desktop-profile-status").write_text("installed\n", encoding="utf-8")
print("KDE Plasma is the active FlexOS desktop.")

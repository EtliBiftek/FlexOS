---
componentName: debian
welcomeStyleCalamares: false
welcomeExpandingLogo: false
windowExpanding: normal
windowSize: 1080px,700px
windowPlacement: center

strings:
    productName:         FlexOS
    shortProductName:    FlexOS
    version:             ""
    shortVersion:        ""
    versionedName:       FlexOS
    shortVersionedName:  FlexOS
    bootloaderEntryName: FlexOS
    productUrl:          https://github.com/EtliBiftek/FlexOS
    supportUrl:          https://github.com/EtliBiftek/FlexOS/issues
    knownIssuesUrl:      https://github.com/EtliBiftek/FlexOS/issues
    releaseNotesUrl:     https://github.com/EtliBiftek/FlexOS/releases
    donateUrl:           ""

# The traditional widget progress view is designed for a vertical sidebar.
# Keeping it on the left avoids the cramped bottom-left layout while preserving
# clear installation-step visibility.
sidebar: widget,left
navigation: widget,bottom

images:
    productLogo:    "flexos-logo.svg"
    productIcon:    "flexos-logo.svg"
    productWelcome: "welcome.svg"

slideshow: "show.qml"
slideshowAPI: 2

style:
    SidebarBackground:        "#17191c"
    SidebarText:              "#9a9da3"
    SidebarTextCurrent:       "#111214"
    SidebarBackgroundCurrent: "#d6d7d9"

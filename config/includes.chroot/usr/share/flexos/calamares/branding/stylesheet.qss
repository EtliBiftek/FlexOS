/* FlexOS Calamares — shared dark UI language for the installer. */

QWidget {
    background-color: #090c12;
    color: #eef2f8;
    font-family: "Noto Sans";
    font-size: 10.5pt;
}

QMainWindow,
QDialog {
    background-color: #090c12;
}

QLabel {
    background-color: transparent;
    color: #dfe5ef;
}

QGroupBox {
    background-color: #10151e;
    border: 1px solid #273142;
    border-radius: 12px;
    margin-top: 13px;
    padding: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 7px;
    color: #ffffff;
    background-color: #090c12;
    font-weight: 600;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QPlainTextEdit,
QTextEdit,
QListView,
QTreeView,
QTableView {
    min-height: 26px;
    background-color: #0d121a;
    color: #eef2f8;
    border: 1px solid #273142;
    border-radius: 9px;
    padding: 7px 10px;
    selection-background-color: #343b73;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QListView:focus,
QTreeView:focus,
QTableView:focus {
    border: 1px solid #7c83ff;
}

QComboBox::drop-down {
    border: 0;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #151b26;
    color: #eef2f8;
    border: 1px solid #273142;
    selection-background-color: #2b3260;
    selection-color: #ffffff;
    outline: 0;
}

QPushButton {
    min-height: 36px;
    background-color: #171e2a;
    color: #eef2f8;
    border: 1px solid #2b3648;
    border-radius: 9px;
    padding: 2px 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1d2635;
    border-color: #3a4860;
}

QPushButton:pressed {
    background-color: #121923;
}

QPushButton:focus {
    border: 1px solid #7c83ff;
}

QPushButton:default {
    background-color: #7c83ff;
    color: #ffffff;
    border-color: #7c83ff;
    font-weight: 700;
}

QPushButton:default:hover {
    background-color: #8b91ff;
}

QPushButton:disabled {
    background-color: #10151d;
    color: #5f6877;
    border-color: #1d2531;
}

QCheckBox,
QRadioButton {
    background-color: transparent;
    spacing: 8px;
    color: #dce2ec;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QHeaderView::section {
    background-color: #151b26;
    color: #cfd7e5;
    border: 0;
    border-right: 1px solid #273142;
    border-bottom: 1px solid #273142;
    padding: 8px;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #273142;
    border-radius: 10px;
    background-color: #10151e;
}

QTabBar::tab {
    min-height: 30px;
    background-color: #111722;
    color: #98a2b3;
    border: 1px solid #273142;
    padding: 5px 13px;
}

QTabBar::tab:selected {
    background-color: #1a2030;
    color: #ffffff;
    border-bottom: 2px solid #7c83ff;
}

QProgressBar {
    min-height: 14px;
    background-color: #0d121a;
    border: 1px solid #273142;
    border-radius: 7px;
    color: #d9e0eb;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #7c83ff;
    border-radius: 6px;
}

QScrollArea {
    border: 0;
    background: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 11px;
    margin: 4px 1px;
}

QScrollBar::handle:vertical {
    background-color: #364156;
    min-height: 34px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a5871;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 11px;
}

QScrollBar::handle:horizontal {
    background-color: #364156;
    min-width: 34px;
    border-radius: 5px;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
}

QToolTip {
    background-color: #171e29;
    color: #ffffff;
    border: 1px solid #344056;
    padding: 6px;
}

/* Calamares keeps its native vertical progress/navigation structure. */
#sidebarApp {
    background-color: #0c1017;
    border-right: 1px solid #273142;
}

#navigationWidget {
    background-color: #0c1017;
    border-top: 1px solid #273142;
}

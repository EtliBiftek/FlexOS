                    ("Sistemi güncelle", lambda: self.admin("update", "install"), "primary", "system-software-update"),
                    ("En hızlı Debian mirror", lambda: self.root_tool("flex-mirror", "apply"), None, "network-server"),
                    ("Optimize repo · Auto", lambda: self.root_tool("flex-repo", "auto"), None, "preferences-system"),
                    ("Baseline repo", lambda: self.root_tool("flex-repo", "select", "baseline"), None, "document-revert"),

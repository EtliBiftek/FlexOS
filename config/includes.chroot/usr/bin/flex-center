ADMIN = "/usr/lib/flexos/flex-admin"
_CAPTURE_CACHE: dict[tuple[str, ...], tuple[float, str]] = {}


def capture(cmd, timeout=6, ttl=10, fresh=False):
    key = tuple(str(part) for part in cmd)
    now = time.monotonic()
    if not fresh and key in _CAPTURE_CACHE:
        when, value = _CAPTURE_CACHE[key]
        if now - when < ttl:
            return value
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
        )
        value = (proc.stdout or "").strip()
    except subprocess.TimeoutExpired:
        value = "İşlem zaman aşımına uğradı. Sayfayı yenileyerek tekrar deneyin."
    except Exception as exc:
        value = str(exc)
    _CAPTURE_CACHE[key] = (now, value)
    return value


def info(text):
    item = label(text or "—", "caption")
    item.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
    return item


def page_header(layout, title_text, subtitle):
    layout.addWidget(label("FLEXOS CONTROL CENTER", "eyebrow"))
    layout.addWidget(label(title_text, "title"))
    layout.addWidget(label(subtitle, "subtitle"))
    layout.addSpacing(6)


def standard_page(title_text, subtitle, body=None, actions=None):
    widget = QWidget()
    layout = QVBoxLayout(widget)
    layout.setContentsMargins(34, 28, 34, 34)
    layout.setSpacing(14)
    page_header(layout, title_text, subtitle)
    if body is not None:
        panel, panel_layout = card()
        panel_layout.addWidget(info(body))
        layout.addWidget(panel)
    if actions:
        layout.addWidget(action_grid(actions))
    layout.addStretch()
    return widget


class Task(QDialog):
    def __init__(self, parent, cmd, title_text):
        super().__init__(parent)
        self.setWindowTitle(title_text)
        self.resize(800, 520)
        self.setMinimumSize(620, 400)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(22, 20, 22, 20)
        layout.setSpacing(12)
        layout.addWidget(label("FLEXOS TASK", "eyebrow"))
        layout.addWidget(label(title_text, "hero"))

        command_card, command_layout = card("Çalıştırılan komut", soft=True)
        command = QLabel(" ".join(shlex.quote(str(part)) for part in cmd))
        command.setObjectName("caption")
        command.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        command.setWordWrap(True)
        command_layout.addWidget(command)
        layout.addWidget(command_card)

        self.progress = QProgressBar()
        self.progress.setRange(0, 0)
        self.progress.setTextVisible(False)
        layout.addWidget(self.progress)

        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setPlaceholderText("İşlem çıktısı burada görünecek…")
        layout.addWidget(self.log, 1)

        footer = QHBoxLayout()
        self.status = label("Çalışıyor…", "muted")
        footer.addWidget(self.status)
        footer.addStretch()
        self.close_button = button("Kapat", self.accept, "primary")
        self.close_button.setEnabled(False)
        footer.addWidget(self.close_button)
        layout.addLayout(footer)

        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.process.readyReadStandardOutput.connect(self.read_output)
        self.process.finished.connect(self.finished)
        self.process.start(cmd[0], [str(part) for part in cmd[1:]])

    def read_output(self):
        text = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        if text:
            self.log.moveCursor(QTextCursor.MoveOperation.End)
            self.log.insertPlainText(text)
            self.log.ensureCursorVisible()

    def finished(self, code, _status):
        self.read_output()
        self.progress.setRange(0, 1)
        self.progress.setValue(1)
        if code == 0:
            self.status.setText("Tamamlandı")
            self.status.setStyleSheet("color:#54d6a0")
        else:
            self.status.setText(f"Başarısız · çıkış kodu {code}")
            self.status.setStyleSheet("color:#ff6b7a")
        self.close_button.setEnabled(True)


class Center(QMainWindow):
    pages = [
        ("overview", "Genel Bakış", "view-dashboard", "Sistem durumu ve hızlı işlemler"),
        ("updates", "Güncellemeler", "system-software-update", "Paketler, mirror ve depolar"),
        ("drivers", "Sürücüler", "preferences-system", "GPU, firmware ve Mesa"),
        ("snapshots", "Snapshot", "document-save", "Btrfs geri dönüş noktaları"),
        ("performance", "Performans", "speedometer", "Scheduler, Ananicy ve bellek"),
        ("gaming", "Gaming", "applications-games", "Oyun araçları ve Proton"),
        ("profiles", "Paket Profilleri", "view-list-details", "Hazır kullanım profilleri"),
        ("apps", "Uygulamalar", "system-software-install", "Önerilen uygulama kataloğu"),
        ("cleanup", "Temizlik", "edit-clear", "Gereksiz sistem verilerini temizle"),
        ("boot", "Boot & Kernel", "system-run", "Kernel ve önyükleme yönetimi"),
        ("recovery", "Recovery", "tools-wizard", "Sistem onarım araçları"),
        ("logs", "Loglar", "view-list-text", "Tanılama ve hata kayıtları"),
        ("backup", "Backup & Sync", "document-save-all", "Snapshot ve rapor dışa aktarma"),
        ("privacy", "Gizlilik", "security-medium", "Yerel veri ve coredump tercihleri"),
        ("security", "Güvenlik", "security-high", "Secure Boot, firewall ve updates"),
        ("hardware", "Donanım", "computer", "Algılanan cihazlar ve handheld profili"),
        ("beta", "Beta QA", "tools-report-bug", "FlexOS doğrulama araçları"),
        ("about", "Hakkında", "help-about", "Sürüm ve proje bilgisi"),
    ]

    def __init__(self, start_page="overview"):
        super().__init__()
        self.setWindowTitle("Flex Center")
        self.resize(1180, 790)
        self.setMinimumSize(900, 620)

        self.builders = [
            self.overview,
            self.updates,
            self.drivers,
            self.snapshots,
            self.performance,
            self.gaming,
            self.package_profiles,
            self.apps,
            self.cleanup,
            self.boot,
            self.recovery,
            self.logs,
            self.backup,
            self.privacy,
            self.security,
            self.hardware,
            self.beta,
            self.about,
        ]
        self.loaded = [False] * len(self.pages)

        root = QWidget()
        root.setObjectName("appRoot")
        self.setCentralWidget(root)
        outer = QHBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        sidebar = QFrame()
        sidebar.setObjectName("sidebar")
        sidebar.setFixedWidth(260)
        side = QVBoxLayout(sidebar)
        side.setContentsMargins(16, 20, 16, 16)
        side.setSpacing(10)

        brand_row = QHBoxLayout()
        mark = QLabel("F")
        mark.setFixedSize(36, 36)
        mark.setAlignment(Qt.AlignmentFlag.AlignCenter)
        mark.setStyleSheet(
            "background:#7c83ff;color:white;border-radius:10px;font-size:19px;font-weight:800"
        )
        brand_row.addWidget(mark)
        brand_text = QVBoxLayout()
        brand_text.setSpacing(0)
        brand_text.addWidget(label("FlexOS", "brand", False))
        brand_text.addWidget(label("System Control", "caption", False))
        brand_row.addLayout(brand_text, 1)
        side.addLayout(brand_row)
        side.addSpacing(4)

        self.search = QLineEdit()
        self.search.setPlaceholderText("Ara…  Ctrl+K")
        themed = icon("edit-find")
        if not themed.isNull():
            self.search.addAction(themed, QLineEdit.ActionPosition.LeadingPosition)
        self.search.textChanged.connect(self.filter_navigation)
        side.addWidget(self.search)

        self.nav = QListWidget()
        self.nav.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.nav.setSpacing(1)
        for index, (key, name, icon_name, _subtitle) in enumerate(self.pages):
            item = QListWidgetItem(name)
            item.setData(Qt.ItemDataRole.UserRole, index)
            themed = icon(icon_name)
            if not themed.isNull():
                item.setIcon(themed)
            item.setToolTip(_subtitle)
            self.nav.addItem(item)
        self.nav.currentItemChanged.connect(self.navigation_changed)
        side.addWidget(self.nav, 1)

        footer_card, footer_layout = card(soft=True)
        footer_layout.setContentsMargins(12, 10, 12, 10)
        footer_layout.addWidget(label("FlexOS Beta", "section"))
        footer_layout.addWidget(label("Debian 13 · CachyOS-derived stack", "caption"))
        side.addWidget(footer_card)
        outer.addWidget(sidebar)

        content = QWidget()
        content_layout = QVBoxLayout(content)
        content_layout.setContentsMargins(0, 0, 0, 0)
        self.stack = QStackedWidget()
        for _ in self.pages:
            self.stack.addWidget(QWidget())
        content_layout.addWidget(self.stack)
        outer.addWidget(content, 1)

        self.search_shortcut=QShortcut(QKeySequence("Ctrl+K"),self)
        self.search_shortcut.activated.connect(self.search.setFocus)
        self.reload_shortcut=QShortcut(QKeySequence("Ctrl+R"),self)
        self.reload_shortcut.activated.connect(self.reload_current)

        requested = next(
            (i for i, page in enumerate(self.pages) if page[0] == start_page), 0
        )
        self.nav.setCurrentRow(requested)

    def filter_navigation(self, text):
        query = text.strip().casefold()
        visible = []
        for row in range(self.nav.count()):
            item = self.nav.item(row)
            index = item.data(Qt.ItemDataRole.UserRole)
            _, name, _, subtitle = self.pages[index]
            matches = not query or query in name.casefold() or query in subtitle.casefold()
            item.setHidden(not matches)
            if matches:
                visible.append(row)
        current = self.nav.currentItem()
        if visible and (current is None or current.isHidden()):
            self.nav.setCurrentRow(visible[0])

    def navigation_changed(self, current, _previous):
        if current is None:
            return
        index = current.data(Qt.ItemDataRole.UserRole)
        self.show_page(index)

    def wrap(self, widget):
        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setFrameShape(QFrame.Shape.NoFrame)
        area.setWidget(widget)
        return area

    def show_page(self, index):
        if index < 0 or index >= len(self.pages):
            return
        if not self.loaded[index]:
            placeholder = self.stack.widget(index)
            page = self.wrap(self.builders[index]())
            self.stack.removeWidget(placeholder)
            placeholder.deleteLater()
            self.stack.insertWidget(index, page)
            self.loaded[index] = True
        self.stack.setCurrentIndex(index)

    def reload_current(self):
        item = self.nav.currentItem()
        if item is None:
            return
        index = item.data(Qt.ItemDataRole.UserRole)
        _CAPTURE_CACHE.clear()
        if self.loaded[index]:
            old = self.stack.widget(index)
            self.stack.removeWidget(old)
            old.deleteLater()
            self.stack.insertWidget(index, QWidget())
            self.loaded[index] = False
        self.show_page(index)

    def task(self, cmd, title_text="FlexOS işlemi"):
        Task(self, cmd, title_text).exec()
        _CAPTURE_CACHE.clear()
        self.reload_current()

    def root_tool(self, name, *args):
        self.task(["pkexec", f"/usr/bin/{name}", *map(str, args)], name)

    def admin(self, *args):
        self.task(["pkexec", ADMIN, *map(str, args)], "FlexOS yönetici işlemi")

    def user_tool(self, name, *args):
        self.task([f"/usr/bin/{name}", *map(str, args)], name)

    def launch_tool(self, name, *args):
        QProcess.startDetached(f"/usr/bin/{name}", [str(arg) for arg in args])

    def overview(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(34, 28, 34, 34)
        layout.setSpacing(14)
        page_header(layout, "Genel Bakış", "Sistemin önemli durumlarını tek ekranda görün.")

        identity = capture(["flexos-info"], timeout=3) or "FlexOS"
        kernel = capture(["uname", "-r"], timeout=2)
        memory = capture(["bash", "-lc", "free -h | sed -n '2p'"], timeout=2)
        disk = capture(["df", "-h", "/"], timeout=2)

        summary, summary_layout = card("Sistem")
        summary_layout.addWidget(info(f"{identity}\n\nKernel: {kernel}"))
        layout.addWidget(summary)

        resource_row = QHBoxLayout()
        memory_card, memory_layout = card("Bellek", soft=True)
        memory_layout.addWidget(info(memory))
        disk_card, disk_layout = card("Disk /", soft=True)
        disk_layout.addWidget(info(disk))
        resource_row.addWidget(memory_card, 1)
        resource_row.addWidget(disk_card, 1)
        layout.addLayout(resource_row)

        layout.addWidget(
            action_grid(
                [
                    ("Sistem raporu", lambda: self.launch_tool("flex-system-report"), "primary", "document-save"),
                    ("Kernel bilgisi", lambda: self.user_tool("flex-kernel-info"), None, "system-run"),
                ]
            )
        )
        layout.addStretch()
        return widget


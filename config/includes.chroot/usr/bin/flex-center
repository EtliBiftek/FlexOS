        r=QHBoxLayout();r.addWidget(self.btn("Hazırla",lambda:self.admin(["snapshot","setup"],"Snapshot setup",self.rsnap)));r.addWidget(self.btn("Snapshot Oluştur",lambda:self.admin(["snapshot","create","FlexOS manual snapshot"],"Snapshot",self.rsnap)));r.addWidget(self.btn("Listele",lambda:self.admin(["snapshot","list"],"Snapshot listesi")));l.addLayout(r)

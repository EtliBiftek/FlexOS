    def drivers(self):
        return standard_page(
            "Sürücüler",
            "Donanıma uygun firmware, Mesa ve NVIDIA sürücülerini yönetin.",
            capture(["flex-hwd"], timeout=5),
            [
                ("Güvenli firmware / Mesa uygula", lambda: self.root_tool("flex-hwd", "--apply-safe"), "primary", "dialog-ok"),
                ("NVIDIA Proprietary", lambda: self.root_tool("flex-hwd", "--nvidia", "proprietary"), None, "video-display"),
                ("NVIDIA Open", lambda: self.root_tool("flex-hwd", "--nvidia", "open"), None, "video-display"),
                ("Nouveau", lambda: self.root_tool("flex-hwd", "--nvidia", "nouveau"), None, "video-display"),
            ],
        )

    def snapshots(self):
        body = capture(["snapper", "-c", "root", "list"], timeout=5) if shutil.which("snapper") else "Snapper kurulu değil."

        def create_snapshot():
            description, ok = QInputDialog.getText(self, "Snapshot", "Açıklama:")
            if ok:
                self.admin("snapshot", "create", description or "FlexOS manual snapshot")

        def delete_snapshot():
            number, ok = QInputDialog.getText(self, "Snapshot sil", "Snapshot numarası:")
            if ok and number.isdigit():
                self.admin("snapshot", "delete", number)

        def rollback_snapshot():
            number, ok = QInputDialog.getText(self, "Rollback", "Snapshot numarası:")
            if not (ok and number.isdigit()):
                return
            answer = QMessageBox.question(
                self,
                "Rollback onayı",
                "Seçilen snapshot geri dönüş için hazırlanacak ve yeniden başlatma gerekecek. Devam edilsin mi?",
            )
            if answer == QMessageBox.StandardButton.Yes:
                self.admin("snapshot", "rollback", number)

        return standard_page(
            "Snapshot",
            "Btrfs geri dönüş noktalarını oluşturun, silin veya rollback hazırlayın.",
            body,
            [
                ("Snapshot altyapısını hazırla", lambda: self.admin("snapshot", "setup"), None, "preferences-system"),
                ("Yeni snapshot", create_snapshot, "primary", "list-add"),
                ("Snapshot sil", delete_snapshot, "danger", "edit-delete"),
                ("Rollback", rollback_snapshot, None, "document-revert"),
            ],
        )


    def performance(self):
        p,l=self.page("Flex Performance","Flex Profiles, zRAM ve swappiness.");c=Card("Flex Profile");self.pc=QComboBox()
        for n in FLEX_PROFILES:self.pc.addItem(n.title(),n)

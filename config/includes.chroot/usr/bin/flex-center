    def run_task(self,label,program,args,refresh=None,cancellable=False):
        if getattr(self,"task",None) and self.task.running():
            QMessageBox.warning(self,"FlexOS","Başka bir yönetim işlemi devam ediyor.")
            return
        def complete(code):
            if refresh:
                try:refresh()
                except Exception:pass
        self.task=TaskDialog(label,program,args,complete,self,cancellable=cancellable)
        self.task.show()

    def admin(self,args,label,refresh=None):
        self.run_task(label,"pkexec",["/usr/lib/flexos/flex-admin"]+args,refresh,cancellable=False)
    def confirm(self,msg,args,label,refresh=None):
        if QMessageBox.question(self,"FlexOS",msg)==QMessageBox.StandardButton.Yes:self.admin(args,label,refresh)

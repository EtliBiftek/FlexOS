class Card(QFrame):
    def __init__(self,t="",d=""):
        super().__init__();self.setObjectName("card");self.l=QVBoxLayout(self);self.l.setContentsMargins(15,13,15,13)
        if t:q=QLabel(t);q.setStyleSheet("font-size:17px;font-weight:600");self.l.addWidget(q)
        if d:q=QLabel(d);q.setObjectName("muted");q.setWordWrap(True);self.l.addWidget(q)

class C(QMainWindow):
    names=["Genel Bakış","Güncellemeler","Sürücüler","Snapshot","Performans","Uygulamalar","Temizlik","Boot & Kernel","Recovery","Loglar","Backup & Sync","Gizlilik","Güvenlik","Donanım","Hakkında"]
    def __init__(self):
        super().__init__();self.setWindowTitle("Flex Center");self.resize(1210,790);self.setMinimumSize(980,650);self.proc=None;self.prev=None
        b=QWidget();self.setCentralWidget(b);o=QHBoxLayout(b);o.setContentsMargins(0,0,0,0);o.setSpacing(0)
        s=QWidget();s.setObjectName("side");s.setFixedWidth(225);sl=QVBoxLayout(s);sl.setContentsMargins(14,18,14,14)
        q=QLabel("F  Flex Center");q.setObjectName("brand");sl.addWidget(q);self.nav=QListWidget();self.nav.addItems(self.names);sl.addWidget(self.nav,1)
        q=QLabel("FlexOS · KDE Plasma Edition\nCreated by Pifo");q.setObjectName("muted");sl.addWidget(q)
        self.stack=QStackedWidget();o.addWidget(s);o.addWidget(self.stack,1)
        for f in (self.overview,self.updates,self.drivers,self.snapshots,self.performance,self.apps,self.cleanup,self.boot,self.recovery,self.logs,self.backup,self.privacy,self.security,self.hardware,self.about):self.stack.addWidget(f())
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex);self.nav.setCurrentRow(0)
        if "--page" in sys.argv:
            try:w=sys.argv[sys.argv.index("--page")+1].lower()
            except:w=""
            for i,n in enumerate(self.names):
                if w in n.lower():self.nav.setCurrentRow(i);break
        self.timer=QTimer(self);self.timer.timeout.connect(self.metrics);self.timer.start(1200);self.metrics()

    def page(self,t,d=""):
        a=QScrollArea();a.setWidgetResizable(True);w=QWidget();a.setWidget(w);l=QVBoxLayout(w);l.setContentsMargins(28,24,28,28);l.setSpacing(13)
        q=QLabel(t);q.setObjectName("title");l.addWidget(q)
        if d:q=QLabel(d);q.setObjectName("muted");q.setWordWrap(True);l.addWidget(q)
        return a,l
    def btn(self,t,fn,primary=False):
        b=QPushButton(t)
        if primary:b.setObjectName("primary")
        b.clicked.connect(fn);return b
    def textcard(self,t,fn):
        c=Card(t);x=QTextEdit();x.setReadOnly(True);x.setPlainText(fn());c.l.addWidget(x);return c,x
    def admin(self,args,label,refresh=None):
        if self.proc and self.proc.state()!=QProcess.ProcessState.NotRunning:QMessageBox.warning(self,"FlexOS","Başka bir işlem devam ediyor.");return
        self.proc=QProcess(self);self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels);self.proc.setProgram("pkexec");self.proc.setArguments(["/usr/lib/flexos/flex-admin"]+args)
        self.proc.finished.connect(lambda code,_:self.done(code,label,refresh));self.proc.start()
    def done(self,code,label,refresh):
        out=bytes(self.proc.readAllStandardOutput()).decode(errors="replace").strip()
        (QMessageBox.information if code==0 else QMessageBox.warning)(self,"FlexOS",f"{label}: {'tamamlandı' if code==0 else 'hata'}\n\n{out[-2800:]}")
        if refresh:
            try:refresh()
            except:pass
    def confirm(self,msg,args,label,refresh=None):
        if QMessageBox.question(self,"FlexOS",msg)==QMessageBox.StandardButton.Yes:self.admin(args,label,refresh)
    def metric(self,n):
        c=Card();v=QLabel("--");v.setObjectName("metric");c.l.addWidget(v);q=QLabel(n);q.setObjectName("muted");c.l.addWidget(q);return c,v

    def overview(self):
        p,l=self.page("Genel Bakış","FlexOS sistem durumu ve donanım önerileri.");g=QGridLayout()
        c,self.cpu=self.metric("CPU");g.addWidget(c,0,0);c,self.ram=self.metric("RAM");g.addWidget(c,0,1);c,self.disk=self.metric("Disk");g.addWidget(c,0,2);c,self.up=self.metric("Uptime");g.addWidget(c,0,3);l.addLayout(g)
        c=Card("Flex Hardware Recommendations");self.rec=QLabel();self.rec.setWordWrap(True);c.l.addWidget(self.rec);l.addWidget(c)
        c=Card("Hızlı İşlemler");r=QHBoxLayout();r.addWidget(self.btn("Flex Doctor",self.doctor));r.addWidget(self.btn("Sistem Raporu",self.report));r.addWidget(self.btn("KDE Sistem Ayarları",lambda:QProcess.startDetached("systemsettings")));c.l.addLayout(r);l.addWidget(c);l.addStretch();return p

    def recovery(self):
        p,l=self.page("Flex Recovery","Terminal kullanmadan temel onarım işlemleri.");g=QGridLayout();acts=[("DPKG Onar",["repair","dpkg"]),("Bozuk Paketleri Onar",["repair","packages"]),("APT İndeksini Onar",["repair","apt"]),("initramfs Yenile",["repair","initramfs"]),("GRUB Yenile",["repair","grub"]),("Ağı Yeniden Başlat",["repair","network"])]
        for i,(n,a) in enumerate(acts):g.addWidget(self.btn(n,lambda _=False,x=a,y=n:self.admin(x,y)),i//2,i%2)
        l.addLayout(g);c=Card("KDE Ayarlarını Sıfırla","Temel Plasma/KWin dosyaları önce yedeklenir.");c.l.addWidget(self.btn("KDE Ayarlarını Sıfırla",self.resetkde));l.addWidget(c);l.addStretch();return p
    def logs(self):
        p,l=self.page("Flex Logs","Failed servisler ve boot uyarıları.");c=Card("Loglar");self.lb=QTextEdit();self.lb.setReadOnly(True);self.lb.setPlainText(logs_summary());c.l.addWidget(self.lb);l.addWidget(c);l.addWidget(self.btn("Yenile",lambda:self.lb.setPlainText(logs_summary())));return p
    def backup(self):
        p,l=self.page("Flex Backup & Sync","KDE/FlexOS ayarlarını .flexbackup olarak taşı.");c=Card("Backup");r=QHBoxLayout();r.addWidget(self.btn("Backup Oluştur",self.backupout));r.addWidget(self.btn("Geri Yükle",self.backupin));c.l.addLayout(r);l.addWidget(c)
        c=Card("Flex Sync","Cloud kimlik bilgisi gömmeden, seçtiğin yerel/senkron klasörde tek güncel backup tutar.");r=QHBoxLayout();r.addWidget(self.btn("Klasöre Sync Et",self.syncout));r.addWidget(self.btn("Klasörden Al",self.syncin));c.l.addLayout(r);l.addWidget(c);l.addStretch();return p
    def privacy(self):
        p,l=self.page("Gizlilik","FlexOS telemetri toplamaz; yerel geçmiş ve crash dump davranışını yönet.");l.addWidget(Card("FlexOS Telemetry","FlexOS'un kendi telemetri veya reklam/izleme servisi yoktur."))
        c=Card("Yerel Geçmiş");r=QHBoxLayout();r.addWidget(self.btn("Clipboard Geçmişini Temizle",self.clip));r.addWidget(self.btn("Recent Files Temizle",self.recent));c.l.addLayout(r);l.addWidget(c)
        c=Card("Crash Dumps");r=QHBoxLayout();r.addWidget(self.btn("Diskte Tutma",lambda:self.admin(["security","coredumps","off"],"Crash dump")));r.addWidget(self.btn("Varsayılan",lambda:self.admin(["security","coredumps","on"],"Crash dump")));c.l.addLayout(r);l.addWidget(c)

    def about(self):
        body = capture(["flexos-info"], timeout=3)
        body += "\n\nFlexOS, Debian 13/Trixie userspace üzerinde FlexOS CachyOS-derived performans bileşenleri kullanır. Arch/CachyOS binary depoları APT ile karıştırılmaz."
        body += "\n\nArayüz: FlexOS UI System · lazy-loaded pages · keyboard-first navigation."
        return standard_page("Hakkında", "FlexOS sürüm ve mimari özeti.", body)


def parse_args():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--page", default="overview")
    args, _unknown = parser.parse_known_args()
    return args


def main():
    args = parse_args()
    app = QApplication(sys.argv)
    app.setApplicationName("Flex Center")
    app.setOrganizationName("FlexOS")
    apply_theme(app)
    window = Center(args.page)
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

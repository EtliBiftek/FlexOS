    def package_profiles(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(34, 28, 34, 34)
        layout.setSpacing(14)
        page_header(layout, "Paket Profilleri", "Kullanım amacına göre hazır araç gruplarını kurun.")
        try:
            profiles = json.loads(Path("/usr/share/flexos/package-profiles.json").read_text())
        except Exception:
            profiles = {}
        if not profiles:
            empty, empty_layout = card("Profil bulunamadı")
            empty_layout.addWidget(label("Paket profili verisi yüklenemedi.", "caption"))
            layout.addWidget(empty)
        for key, spec in profiles.items():
            panel, panel_layout = card(spec.get("name", key), soft=True)
            panel_layout.addWidget(label(spec.get("description", ""), "caption"))
            panel_layout.addWidget(
                button(
                    "Profili uygula",
                    lambda _checked=False, profile=key: self.task(
                        ["pkexec", "/usr/lib/flexos/flex-package-profile-install", profile],
                        f"Paket profili · {profile}",
                    ),
                    "primary",
                )
            )
            layout.addWidget(panel)
        layout.addStretch()
        return widget

    def apps(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(34, 28, 34, 34)
        layout.setSpacing(14)
        page_header(layout, "Uygulamalar", "FlexOS tarafından önerilen uygulamaları APT veya Flatpak ile kurun.")
        try:
            apps = json.loads(Path("/usr/share/flexos/apps.json").read_text())
        except Exception:
            apps = []
        if not apps:
            panel, panel_layout = card("Katalog yüklenemedi")
            panel_layout.addWidget(label("Uygulama kataloğu bulunamadı.", "caption"))
            layout.addWidget(panel)
        for app in apps:
            panel, panel_layout = card(app.get("name", "Uygulama"), soft=True)
            panel_layout.addWidget(label(app.get("description", ""), "caption"))
            if app.get("method") == "apt":
                install = lambda _checked=False, package=app["package"]: self.admin("app", "apt", package)
            else:
                install = lambda _checked=False, package=app["package"]: self.task(
                    ["flatpak", "install", "--user", "-y", "flathub", package],
                    "Flatpak kurulumu",
                )
            panel_layout.addWidget(button("Kur", install, "primary", "system-software-install"))
            layout.addWidget(panel)
        layout.addStretch()
        return widget

    def cleanup(self):
        return standard_page(
            "Temizlik",
            "Güvenli sistem temizliği öncesinde otomatik snapshot oluşturulur.",
            "APT autoremove/cache ve eski journal verileri temizlenir. Kişisel dosyalara dokunulmaz.",
            [("Sistem temizliğini başlat", lambda: self.admin("cleanup", "system"), "primary", "edit-clear")],
        )

    def boot(self):
        body = capture(["flex-kernel-info"], timeout=4) + "\n\n" + capture(["flex-kernel-manager", "status"], timeout=4)
        return standard_page(
            "Boot & Kernel",
            "FlexOS kerneli, Debian fallback ve GRUB durumunu yönetin.",
            body,
            [
                ("CachyOS kerneli güncelle", lambda: self.root_tool("flex-kernel-manager", "update-cachy"), "primary", "system-software-update"),
                ("Debian fallback kur / onar", lambda: self.root_tool("flex-kernel-manager", "install-fallback")),
                ("Debian backports kernel", lambda: self.admin("kernel", "backports")),
                ("GRUB güncelle", lambda: self.admin("repair", "grub"), None, "view-refresh"),
            ],
        )

    def recovery(self):
        return standard_page(
            "Recovery",
            "APT, dpkg, initramfs, GRUB ve ağ için güvenli onarım kısayolları.",
            "Her işlem ayrı çalıştırılır ve çıktısı gösterilir. Kritik değişikliklerde mevcut FlexOS yönetici oturumu yeniden kullanılır.",
            [
                ("dpkg yapılandır", lambda: self.admin("repair", "dpkg"), "primary"),
                ("Paket bağımlılıklarını onar", lambda: self.admin("repair", "packages")),
                ("APT listelerini yenile", lambda: self.admin("repair", "apt")),
                ("initramfs yenile", lambda: self.admin("repair", "initramfs")),
                ("GRUB yenile", lambda: self.admin("repair", "grub")),
                ("NetworkManager yeniden başlat", lambda: self.admin("repair", "network")),
            ],
        )

    def logs(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(34, 28, 34, 34)
        layout.setSpacing(14)
        page_header(layout, "Loglar", "Son boot uyarıları ve FlexOS yönetici kayıtlarını inceleyin.")
        text = "\n".join(
            [
                capture(["journalctl", "-b", "-p", "warning", "--no-pager", "-n", "100"], timeout=5),
                capture(["tail", "-n", "80", "/var/log/flexos-admin.log"], timeout=3),
            ]
        )
        log = QPlainTextEdit()
        log.setReadOnly(True)
        log.setPlainText(text or "Gösterilecek kayıt yok.")
        layout.addWidget(log, 1)
        layout.addWidget(
            action_grid(
                [("Sistem raporu oluştur", lambda: self.launch_tool("flex-system-report"), "primary", "document-save")]
            )
        )
        return widget

    def backup(self):
        def report():
            destination, _ = QFileDialog.getSaveFileName(
                self,
                "Sistem raporu kaydet",
                str(Path.home() / "FlexOS-System-Report.zip"),
                "ZIP (*.zip)",
            )
            if destination:
                self.task(["flex-system-report", destination], "Sistem raporu")

        return standard_page(
            "Backup & Sync",
            "Btrfs snapshot ve taşınabilir tanılama raporları oluşturun.",
            "FlexOS kişisel verileri otomatik olarak dışarı göndermez. Sistem raporu yerel olarak oluşturulur.",
            [
                ("Snapshot oluştur", lambda: self.admin("snapshot", "create", "Before manual backup"), "primary", "document-save"),
                ("Sistem raporunu kaydet", report, None, "document-save-as"),
            ],
        )

    def privacy(self):
        return standard_page(
            "Gizlilik",
            "Yerel tanılama ve konum servislerini kullanıcı kontrolünde tutun.",
            "Coredump ve konum servisleri isteğe bağlıdır. FlexOS kendi telemetri servisini çalıştırmaz.",
            [
                ("Coredump kapat", lambda: self.admin("security", "coredumps", "off"), "primary"),
                ("Coredump aç", lambda: self.admin("security", "coredumps", "on")),
                ("Konum kapat", lambda: self.admin("security", "location", "off")),
                ("Konum aç", lambda: self.admin("security", "location", "on")),
            ],
        )

    def security(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(34, 28, 34, 34)
        layout.setSpacing(14)
        page_header(layout, "Güvenlik", "Secure Boot, firewall ve otomatik güvenlik güncellemelerini yönetin.")

        secure, secure_layout = card("Secure Boot / MOK")
        secure_layout.addWidget(info(secureboot_status()))
        secure_layout.addWidget(
            action_grid(
                [
                    ("MOK anahtarı hazırla", lambda: self.root_tool("flex-secureboot", "setup-mok"), "primary"),
                    ("MOK enrollment iste", lambda: self.root_tool("flex-secureboot", "enroll")),
                    ("FlexOS kernelini imzala", lambda: self.root_tool("flex-secureboot", "sign-kernels")),
                    ("DKMS modüllerini imzala", lambda: self.root_tool("flex-secureboot", "sign-modules")),
                ]
            )
        )
        layout.addWidget(secure)

        firewall, firewall_layout = card("Firewall & updates", soft=True)
        firewall_layout.addWidget(
            action_grid(
                [
                    ("Firewall aç", lambda: self.admin("security", "firewall", "on"), "primary"),
                    ("Firewall kapat", lambda: self.admin("security", "firewall", "off"), "danger"),
                    ("Otomatik güncelleme aç", lambda: self.admin("security", "autoupdates", "on")),
                    ("Otomatik güncelleme kapat", lambda: self.admin("security", "autoupdates", "off"), "danger"),
                ]
            )
        )
        layout.addWidget(firewall)
        layout.addStretch()
        return widget

    def hardware(self):
        body = capture(["flex-hwd"], timeout=5) + f"\n\nDetected handheld profile: {handheld_status()}"
        return standard_page(
            "Donanım",
            "Algılanan donanım, sürücü önerileri ve handheld profilini görün.",
            body,
            [
                ("Güvenli sürücü / firmware uygula", lambda: self.root_tool("flex-hwd", "--apply-safe"), "primary"),
                ("Handheld profili uygula", lambda: self.root_tool("flex-hwd", "--apply-handheld")),
            ],
        )

    def beta(self):
        return standard_page(
            "Beta QA",
            "FlexOS beta doğrulama ve kernel teşhis araçlarını çalıştırın.",
            "Bu araçlar sistem durumunu toplar; değişiklik yapan işlemler ayrı yönetici onayı ister.",

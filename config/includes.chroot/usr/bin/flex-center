        c=Card("Otomatik Güvenlik Güncellemeleri");r=QHBoxLayout();r.addWidget(self.btn("Aç",lambda:self.admin(["security","autoupdates","on"],"Security updates",self.rsec)));r.addWidget(self.btn("Kapat",lambda:self.admin(["security","autoupdates","off"],"Security updates",self.rsec)));c.l.addLayout(r);l.addWidget(c);l.addStretch();return p
    def hardware(self):

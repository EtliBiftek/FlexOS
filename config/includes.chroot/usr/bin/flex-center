sys.path.insert(0, "/usr/lib/flexos")
from flexlib import FLEX_PROFILES, current_profile, doctor, hardware_text, identity, package_profiles

WALLPAPER="/usr/share/wallpapers/FlexOS/contents/images/2560x1440.svg"
QSS='''

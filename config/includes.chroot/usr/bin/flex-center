class TaskDialog(QDialog):
    def __init__(self,title,program,args,on_done=None,parent=None,cancellable=False):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(760,470)
        self.on_done=on_done
        self.cancellable=cancellable
        self.proc=QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)

        lay=QVBoxLayout(self)
        self.state=QLabel(f"{title} çalışıyor...")
        self.state.setStyleSheet("font-size:17px;font-weight:600")
        lay.addWidget(self.state)

        self.progress=QProgressBar()
        self.progress.setRange(0,0)
        lay.addWidget(self.progress)

        self.log=QTextEdit()
        self.log.setReadOnly(True)
        lay.addWidget(self.log,1)

        row=QHBoxLayout()
        row.addStretch()
        self.cancel=QPushButton("İptal" if cancellable else "İşlem sırasında iptal edilemez")
        self.cancel.setEnabled(cancellable)
        self.cancel.clicked.connect(self.cancel_task)
        row.addWidget(self.cancel)
        self.closeb=QPushButton("Kapat")
        self.closeb.setEnabled(False)
        self.closeb.clicked.connect(self.close)
        row.addWidget(self.closeb)
        lay.addLayout(row)

        self.proc.readyReadStandardOutput.connect(self.read_output)
        self.proc.finished.connect(self.finished_task)
        self.proc.setProgram(program)
        self.proc.setArguments(args)
        self.proc.start()

    def running(self):
        return self.proc.state()!=QProcess.ProcessState.NotRunning

    def read_output(self):
        chunk=bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        if chunk:
            self.log.moveCursor(QTextCursor.MoveOperation.End)
            self.log.insertPlainText(chunk)
            self.log.ensureCursorVisible()

    def cancel_task(self):
        if not self.cancellable or not self.running():
            return
        if QMessageBox.question(self,"FlexOS","Çalışan işlemi iptal etmek istediğinize emin misiniz?")==QMessageBox.StandardButton.Yes:
            self.proc.terminate()
            if not self.proc.waitForFinished(2500):
                self.proc.kill()

    def finished_task(self,code,_status):
        self.read_output()
        self.progress.setRange(0,1)
        self.progress.setValue(1)
        self.cancel.setEnabled(False)
        self.closeb.setEnabled(True)
        reboot=Path("/run/flexos-reboot-required")
        debian_reboot=Path("/var/run/reboot-required")
        if code==0 and (reboot.exists() or debian_reboot.exists()):
            reasons=[]
            if reboot.exists():
                try:
                    reason=reboot.read_text(errors="ignore").strip()
                    if reason:reasons.append(reason)
                except Exception:pass
            if debian_reboot.exists():
                try:
                    reason=debian_reboot.read_text(errors="ignore").strip()
                    if reason:reasons.append(reason)
                except Exception:pass
            self.state.setText("İşlem tamamlandı — yeniden başlatma öneriliyor.")
            if reasons:self.log.append("\nYeniden başlatma nedeni: "+"; ".join(reasons))
        else:
            self.state.setText("İşlem tamamlandı." if code==0 else f"İşlem hata koduyla bitti: {code}")
        if self.on_done:
            try:self.on_done(code)
            except Exception:pass


class Card(QFrame):
    def __init__(self,t="",d=""):
        super().__init__();self.setObjectName("card");self.l=QVBoxLayout(self);self.l.setContentsMargins(15,13,15,13)
        if t:q=QLabel(t);q.setStyleSheet("font-size:17px;font-weight:600");self.l.addWidget(q)
        if d:q=QLabel(d);q.setObjectName("muted");q.setWordWrap(True);self.l.addWidget(q)


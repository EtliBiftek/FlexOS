#!/usr/bin/env python3
from __future__ import annotations
import json, os, shlex, shutil, subprocess, sys
from pathlib import Path
from PyQt6.QtCore import QProcess, Qt
from PyQt6.QtWidgets import (QApplication,QComboBox,QDialog,QFileDialog,QFormLayout,QHBoxLayout,QInputDialog,QLabel,QListWidget,QMainWindow,QMessageBox,QPlainTextEdit,QPushButton,QScrollArea,QStackedWidget,QVBoxLayout,QWidget)

sys.path.insert(0,'/usr/lib/flexos')
try:
    from flexcachy import scx_status,ananicy_status,gaming_status,repo_status,secureboot_status,handheld_status
except Exception:
    scx_status=lambda:'unavailable';ananicy_status=lambda:'unavailable';gaming_status=lambda:'unavailable';repo_status=lambda:'unavailable';secureboot_status=lambda:'unavailable';handheld_status=lambda:'none'

ADMIN='/usr/lib/flexos/flex-admin'

def capture(cmd,timeout=12):
    try:
        p=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=timeout)
        return (p.stdout or '').strip()
    except Exception as e:return str(e)
def title(text):
    l=QLabel(text);l.setObjectName('title');return l
def section(text):
    l=QLabel(text);l.setObjectName('section');return l
def info(text):
    l=QLabel(text or '—');l.setWordWrap(True);l.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse);return l
def button(text,fn):
    b=QPushButton(text);b.clicked.connect(fn);return b

def box_page(name,body,buttons=None):
    w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title(name));v.addWidget(info(body));
    if buttons:
        row=QHBoxLayout()
        for text,fn in buttons:row.addWidget(button(text,fn))
        row.addStretch();v.addLayout(row)
    v.addStretch();return w

class Task(QDialog):
    def __init__(self,parent,cmd,label):
        super().__init__(parent);self.setWindowTitle(label);self.resize(760,480)
        v=QVBoxLayout(self);v.addWidget(QLabel(' '.join(shlex.quote(x) for x in cmd)))
        self.log=QPlainTextEdit();self.log.setReadOnly(True);v.addWidget(self.log,1)
        self.closeb=QPushButton('Kapat');self.closeb.setEnabled(False);self.closeb.clicked.connect(self.accept);v.addWidget(self.closeb)
        self.p=QProcess(self);self.p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.p.readyReadStandardOutput.connect(self.read);self.p.finished.connect(self.done)
        self.p.start(cmd[0],cmd[1:])
    def read(self):self.log.appendPlainText(bytes(self.p.readAllStandardOutput()).decode(errors='replace').rstrip())
    def done(self,code,_):self.read();self.log.appendPlainText(f'\nExit: {code}');self.closeb.setEnabled(True)

class Center(QMainWindow):
    names=['Genel Bakış','Güncellemeler','Sürücüler','Snapshot','Performans','Gaming','Paket Profilleri','Uygulamalar','Temizlik','Boot & Kernel','Recovery','Loglar','Backup & Sync','Gizlilik','Güvenlik','Donanım','Beta QA','Hakkında']
    def __init__(self):
        super().__init__();self.setWindowTitle('Flex Center');self.resize(1120,760)
        root=QWidget();self.setCentralWidget(root);h=QHBoxLayout(root);h.setContentsMargins(0,0,0,0);h.setSpacing(0)
        self.nav=QListWidget();self.nav.setFixedWidth(220);self.nav.addItems(self.names);h.addWidget(self.nav)
        self.stack=QStackedWidget();h.addWidget(self.stack,1)
        self.builders=[self.overview,self.updates,self.drivers,self.snapshots,self.performance,self.gaming,self.package_profiles,self.apps,self.cleanup,self.boot,self.recovery,self.logs,self.backup,self.privacy,self.security,self.hardware,self.beta,self.about]
        for f in self.builders:self.stack.addWidget(self.wrap(f()))
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex);self.nav.setCurrentRow(0)
        self.setStyleSheet('''
          QMainWindow,QWidget{background:#111216;color:#e8e9ee;font-size:14px} QListWidget{background:#0b0c0f;border:0;padding:14px 8px} QListWidget::item{padding:11px 13px;border-radius:8px;margin:2px} QListWidget::item:selected{background:#272a32;color:white} QLabel#title{font-size:27px;font-weight:700;padding-bottom:10px} QLabel#section{font-size:17px;font-weight:650;padding-top:12px} QPushButton{background:#262932;border:1px solid #383c48;padding:9px 13px;border-radius:7px} QPushButton:hover{background:#303440} QPlainTextEdit,QComboBox{background:#17191f;border:1px solid #353945;border-radius:6px;padding:7px} QScrollArea{border:0}''')
    def wrap(self,w):
        s=QScrollArea();s.setWidgetResizable(True);s.setWidget(w);return s
    def task(self,cmd,label='FlexOS işlemi'):Task(self,cmd,label).exec()
    def root_tool(self,name,*args):self.task(['pkexec',f'/usr/bin/{name}',*map(str,args)],name)
    def admin(self,*args):self.task(['pkexec',ADMIN,*map(str,args)],'FlexOS yönetici işlemi')
    def user_tool(self,name,*args):self.task([f'/usr/bin/{name}',*map(str,args)],name)
    def command_text(self,cmd):return capture(cmd)
    def overview(self):
        body='\n'.join([capture(['flexos-info']) or 'FlexOS',f"Kernel: {capture(['uname','-r'])}",capture(['bash','-lc',"free -h | sed -n '1,2p'"]),capture(['df','-h','/'])])
        return box_page('Flex Center',body,[('Sistem raporu',lambda:self.user_tool('flex-system-report')),('Kernel bilgisi',lambda:self.user_tool('flex-kernel-info'))])
    def updates(self):
        w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title('Güncellemeler & Depolar'))
        apt=capture(['bash','-lc',"apt list --upgradable 2>/dev/null | tail -n +2 | head -n 30"]);v.addWidget(info(apt or 'Güncel paket listesi için APT yenile.'))
        v.addWidget(section('Mirror'));v.addWidget(info(capture(['flex-mirror','status'])));v.addWidget(section('Optimize repo'));v.addWidget(info(repo_status()))
        for text,fn in [('APT yenile',lambda:self.admin('update','refresh')),('Sistemi güncelle',lambda:self.admin('update','install')),('En hızlı Debian mirror',lambda:self.root_tool('flex-mirror','apply')),('Optimize repo: Auto',lambda:self.root_tool('flex-repo','auto')),('Baseline repo',lambda:self.root_tool('flex-repo','select','baseline'))]:v.addWidget(button(text,fn))
        v.addStretch();return w
    def drivers(self):
        body=capture(['flex-hwd'])
        return box_page('Sürücüler',body,[('Güvenli firmware/Mesa uygula',lambda:self.root_tool('flex-hwd','--apply-safe')),('NVIDIA Proprietary',lambda:self.root_tool('flex-hwd','--nvidia','proprietary')),('NVIDIA Open',lambda:self.root_tool('flex-hwd','--nvidia','open')),('Nouveau',lambda:self.root_tool('flex-hwd','--nvidia','nouveau'))])
    def snapshots(self):
        body=capture(['snapper','-c','root','list']) if shutil.which('snapper') else 'Snapper yok.'
        def create():
            d,ok=QInputDialog.getText(self,'Snapshot','Açıklama:');
            if ok:self.admin('snapshot','create',d or 'FlexOS manual snapshot')
        def delete():
            n,ok=QInputDialog.getText(self,'Snapshot sil','Snapshot numarası:');
            if ok and n.isdigit():self.admin('snapshot','delete',n)
        def rollback():
            n,ok=QInputDialog.getText(self,'Rollback','Snapshot numarası:');
            if ok and n.isdigit() and QMessageBox.question(self,'Onay','Rollback hazırlanacak ve yeniden başlatma gerekecek. Devam?')==QMessageBox.StandardButton.Yes:self.admin('snapshot','rollback',n)
        return box_page('Snapshot',body,[('Kurulumu hazırla',lambda:self.admin('snapshot','setup')),('Yeni snapshot',create),('Sil',delete),('Rollback',rollback)])
    def performance(self):
        w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title('Performans'))
        v.addWidget(info(capture(['flex-kernel-info'])));v.addWidget(section('SCX sched_ext'));v.addWidget(info(scx_status()))
        row=QHBoxLayout();sched=QComboBox();sched.addItems(['scx_lavd','scx_bpfland','scx_rusty','scx_flash','scx_cosmos','scx_cake']);mode=QComboBox();mode.addItems(['Auto','Gaming','LowLatency','PowerSave','Server']);row.addWidget(sched);row.addWidget(mode);row.addWidget(button('Uygula',lambda:self.root_tool('flex-scx','set',sched.currentText(),mode.currentText())));v.addLayout(row)
        for text,fn in [('SCX userspace kur',lambda:self.root_tool('flex-scx','install')),('SCX kapat',lambda:self.root_tool('flex-scx','disable'))]:v.addWidget(button(text,fn))
        v.addWidget(section('Ananicy'));v.addWidget(info(ananicy_status()))
        r=QHBoxLayout();
        for text,args in [('Kur',['install']),('Etkinleştir',['enable']),('Kapat',['disable']),('Kuralları güncelle',['update-rules'])]:r.addWidget(button(text,lambda _=False,a=args:self.root_tool('flex-ananicy',*a)))
        v.addLayout(r);v.addWidget(section('Bellek'))
        r=QHBoxLayout();r.addWidget(button('zRAM aç',lambda:self.root_tool('flex-performance-config','zram','on')));r.addWidget(button('zRAM kapat',lambda:self.root_tool('flex-performance-config','zram','off')))
        def swap():
            n,ok=QInputDialog.getInt(self,'Swappiness','Değer:',100,1,200)
            if ok:self.root_tool('flex-performance-config','swappiness',str(n))
        r.addWidget(button('Swappiness',swap));v.addLayout(r);v.addStretch();return w
    def gaming(self):
        w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title('Gaming Stack'));v.addWidget(info(gaming_status()))
        v.addWidget(QLabel('Steam/umu sistem paketidir; Heroic ve Proton-CachyOS kullanıcı hesabına kurulur. Proton assetleri SHA256 ile doğrulanır.'))
        for text,fn in [('Core: GameMode + MangoHud + GOverlay + Lutris',lambda:self.root_tool('flex-gaming','install-core')),('Steam + i386 Vulkan',lambda:self.root_tool('flex-gaming','install-steam')),('Gamescope (Trixie Backports)',lambda:self.root_tool('flex-gaming','install-gamescope')),('umu-launcher',lambda:self.root_tool('flex-gaming','install-umu')),('Heroic (Flatpak)',lambda:self.user_tool('flex-gaming','install-heroic')),('Proton-CachyOS',lambda:self.user_tool('flex-gaming','install-proton-cachyos'))]:v.addWidget(button(text,fn))
        v.addStretch();return w
    def package_profiles(self):
        w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title('Paket Profilleri'))
        try:d=json.loads(Path('/usr/share/flexos/package-profiles.json').read_text())
        except Exception:d={}
        for key,spec in d.items():
            v.addWidget(section(spec.get('name',key)));v.addWidget(info(spec.get('description','')));v.addWidget(button('Profili uygula',lambda _=False,k=key:self.task(['pkexec','/usr/lib/flexos/flex-package-profile-install',k],f'Paket profili: {k}')))
        v.addStretch();return w
    def apps(self):
        w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title('Uygulamalar'))
        try:apps=json.loads(Path('/usr/share/flexos/apps.json').read_text())
        except Exception:apps=[]
        for a in apps:
            v.addWidget(section(a.get('name','App')));v.addWidget(info(a.get('description','')))
            if a.get('method')=='apt':fn=lambda _=False,p=a['package']:self.admin('app','apt',p)
            else:fn=lambda _=False,p=a['package']:self.task(['flatpak','install','--user','-y','flathub',p],'Flatpak kurulumu')
            v.addWidget(button('Kur',fn))
        v.addStretch();return w
    def cleanup(self):return box_page('Temizlik','APT autoremove/cache ve eski journal verisini temizler. İşlem öncesi snapshot alınır.',[('Sistem temizliği',lambda:self.admin('cleanup','system'))])
    def boot(self):
        body=capture(['flex-kernel-info'])+'\n\n'+capture(['flex-kernel-manager','status'])
        return box_page('Boot & Kernel',body,[('CachyOS kerneli güncelle',lambda:self.root_tool('flex-kernel-manager','update-cachy')),('Debian fallback kur/onar',lambda:self.root_tool('flex-kernel-manager','install-fallback')),('Debian backports kernel',lambda:self.admin('kernel','backports')),('GRUB güncelle',lambda:self.admin('repair','grub'))])
    def recovery(self):return box_page('Recovery','FlexOS recovery target; APT/dpkg, initramfs, GRUB ve ağ onarım araçları.',[('dpkg yapılandır',lambda:self.admin('repair','dpkg')),('Paket bağımlılıklarını onar',lambda:self.admin('repair','packages')),('APT listelerini yenile',lambda:self.admin('repair','apt')),('initramfs yenile',lambda:self.admin('repair','initramfs')),('GRUB yenile',lambda:self.admin('repair','grub')),('NetworkManager yeniden başlat',lambda:self.admin('repair','network'))])
    def logs(self):
        body='\n'.join([capture(['journalctl','-b','-p','warning','--no-pager','-n','100']),capture(['tail','-n','80','/var/log/flexos-admin.log'])])
        return box_page('Loglar',body,[('System report oluştur',lambda:self.user_tool('flex-system-report'))])
    def backup(self):
        def report():
            dst,_=QFileDialog.getSaveFileName(self,'Sistem raporu kaydet',str(Path.home()/'FlexOS-System-Report.zip'),'ZIP (*.zip)')
            if dst:self.task(['flex-system-report',dst],'Sistem raporu')
        return box_page('Backup & Sync','Btrfs snapshot + taşınabilir sistem raporu. Kişisel veriler otomatik olarak dışarı gönderilmez.',[('Snapshot oluştur',lambda:self.admin('snapshot','create','Before manual backup')),('Sistem raporunu kaydet',report)])
    def privacy(self):return box_page('Gizlilik','Coredump ve konum servisleri kullanıcı kontrolündedir.',[('Coredump kapat',lambda:self.admin('security','coredumps','off')),('Coredump aç',lambda:self.admin('security','coredumps','on')),('Konum kapat',lambda:self.admin('security','location','off')),('Konum aç',lambda:self.admin('security','location','on'))])
    def security(self):
        w=QWidget();v=QVBoxLayout(w);v.setContentsMargins(28,24,28,24);v.addWidget(title('Güvenlik'));v.addWidget(info(secureboot_status()));v.addWidget(section('Secure Boot / MOK'))
        for text,args in [('MOK anahtarı hazırla',['setup-mok']),('MOK enrollment iste',['enroll']),('FlexOS kernelini imzala',['sign-kernels']),('DKMS modüllerini imzala',['sign-modules'])]:v.addWidget(button(text,lambda _=False,a=args:self.root_tool('flex-secureboot',*a)))
        v.addWidget(section('Firewall & updates'));r=QHBoxLayout();r.addWidget(button('Firewall aç',lambda:self.admin('security','firewall','on')));r.addWidget(button('Firewall kapat',lambda:self.admin('security','firewall','off')));r.addWidget(button('Otomatik güncelleme aç',lambda:self.admin('security','autoupdates','on')));r.addWidget(button('Kapat',lambda:self.admin('security','autoupdates','off')));v.addLayout(r);v.addStretch();return w
    def hardware(self):
        body=capture(['flex-hwd'])+f'\n\nDetected handheld profile: {handheld_status()}'
        return box_page('Donanım',body,[('Güvenli sürücü/firmware uygula',lambda:self.root_tool('flex-hwd','--apply-safe')),('Handheld profili uygula',lambda:self.root_tool('flex-hwd','--apply-handheld'))])
    def beta(self):return box_page('Beta QA','FlexOS doğrulama ve beta kontrol araçları.',[('Beta check',lambda:self.user_tool('flex-beta-check')),('Kernel teşhisi',lambda:self.user_tool('flex-kernel-info')),('SCX durumu',lambda:self.user_tool('flex-scx','status'))])
    def about(self):return box_page('Hakkında',capture(['flexos-info'])+'\n\nFlexOS Debian 13/Trixie userspace + FlexOS CachyOS-derived performance stack. Arch/CachyOS binary repositories are not mixed into APT.')

def main():
    app=QApplication(sys.argv);app.setApplicationName('Flex Center');w=Center();w.show();sys.exit(app.exec())
if __name__=='__main__':main()

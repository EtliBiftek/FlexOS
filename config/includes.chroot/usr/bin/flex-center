    def about(self):
        p,l=self.page("Hakkında","FlexOS dağıtım kimliği.");c=Card("FlexOS");q=QLabel("<b>FlexOS 0.1 Alpha</b><br><br>Created by <b>Pifo</b><br>Base: Debian 13 (Trixie)<br>Desktop: KDE Plasma 6<br><br>Clean. Flexible. Yours.");q.setWordWrap(True);c.l.addWidget(q);l.addWidget(c);l.addStretch();return p

    def metrics(self):
        try:v=list(map(int,Path("/proc/stat").read_text().splitlines()[0].split()[1:]));idle=v[3]+v[4];tot=sum(v);cpu=0 if not self.prev else 100*(1-(idle-self.prev[0])/(tot-self.prev[1] or 1));self.prev=(idle,tot)
        except:cpu=0
        try:d={x.split(":")[0]:int(x.split()[1]) for x in Path("/proc/meminfo").read_text().splitlines() if ":" in x};mem=100*(1-d.get("MemAvailable",0)/d.get("MemTotal",1))
        except:mem=0
        try:u=shutil.disk_usage("/");disk=100*u.used/u.total
        except:disk=0
        try:sec=int(float(Path("/proc/uptime").read_text().split()[0]));up=f"{sec//3600} sa {(sec%3600)//60} dk"
        except:up="?"
        self.cpu.setText(f"{cpu:.0f}%");self.ram.setText(f"{mem:.0f}%");self.disk.setText(f"{disk:.0f}%");self.up.setText(up);self.rec.setText("\n".join(f"[{a}] {b}" for a,b in recommendations()))
    def rsnap(self):self.sl.setText(snapshot_status())
    def rsec(self):self.sb.setPlainText(security_status())
    def profile(self):
        subprocess.run(["pkexec","/usr/bin/flex","profile","set",self.pc.currentData()])
    def install(self,a):
        if a["method"]=="flatpak":
            rc,o=install_flatpak_user(a["package"]);QMessageBox.information(self,"Flex App Installer",o[-2500:] or ("Kuruldu." if rc==0 else "Kurulamadı."))
        else:self.admin(["app","apt",a["package"]],a["name"])
    def delsnap(self):
        n,ok=QInputDialog.getText(self,"Snapshot Sil","Snapshot ID:")
        if ok and n.isdigit():self.admin(["snapshot","delete",n],"Snapshot silme",self.rsnap)
    def rollback(self):
        n,ok=QInputDialog.getText(self,"Rollback","Snapshot ID:")
        if ok and n.isdigit():self.confirm("Rollback reboot gerektirir. Devam?",["snapshot","rollback",n],"Rollback")
    def userclean(self):shutil.rmtree(Path.home()/".cache/thumbnails",ignore_errors=True);QMessageBox.information(self,"Flex Cleanup","Thumbnail cache temizlendi.")
    def resetkde(self):
        if QMessageBox.question(self,"Flex Recovery","KDE ayarları yedeklenip sıfırlansın mı?")!=QMessageBox.StandardButton.Yes:return
        st=time.strftime("%Y%m%d-%H%M%S")
        for n in ("plasma-org.kde.plasma.desktop-appletsrc","kwinrc","kdeglobals"):
            p=Path.home()/".config"/n
            if p.exists():p.rename(p.with_name(p.name+".flexbak-"+st))
        QMessageBox.information(self,"Flex Recovery","Yedeklendi. Oturumu kapatıp açın.")
    def backupout(self):
        f,_=QFileDialog.getSaveFileName(self,"Flex Backup",str(Path.home()/"FlexOS.flexbackup"),"FlexOS Backup (*.flexbackup)")
        if f:create_backup(f);QMessageBox.information(self,"Flex Backup",f)
    def backupin(self):
        f,_=QFileDialog.getOpenFileName(self,"Flex Backup","","FlexOS Backup (*.flexbackup)")
        if f:QMessageBox.information(self,"Flex Backup",f"{restore_backup(f)} dosya geri yüklendi.")
    def syncout(self):
        d=QFileDialog.getExistingDirectory(self,"Flex Sync")
        if d:f=str(Path(d)/"FlexOS-sync.flexbackup");create_backup(f);QMessageBox.information(self,"Flex Sync",f)
    def syncin(self):
        d=QFileDialog.getExistingDirectory(self,"Flex Sync")
        if d:
            f=Path(d)/"FlexOS-sync.flexbackup"
            QMessageBox.information(self,"Flex Sync",f"{restore_backup(f)} dosya geri alındı.") if f.exists() else QMessageBox.warning(self,"Flex Sync","Backup bulunamadı.")
    def clip(self):
        for q in ("qdbus6","qdbus"):
            if shutil.which(q):subprocess.run([q,"org.kde.klipper","/klipper","org.kde.klipper.klipper.clearClipboardHistory"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL);break
        QMessageBox.information(self,"Gizlilik","Clipboard temizleme isteği gönderildi.")
    def recent(self):shutil.rmtree(Path.home()/".local/share/RecentDocuments",ignore_errors=True);(Path.home()/".local/share/RecentDocuments").mkdir(parents=True,exist_ok=True);QMessageBox.information(self,"Gizlilik","Recent Files temizlendi.")
    def doctor(self):QMessageBox.information(self,"Flex Doctor 2.0","\n".join(f"[{a}] {b}" for a,b in doctor())+"\n\n"+"\n".join(f"[{a}] {b}" for a,b in recommendations()))
    def report(self):
        f,_=QFileDialog.getSaveFileName(self,"Sistem Raporu",str(Path.home()/"Desktop"/"FlexOS-System-Report.zip"),"ZIP (*.zip)")
        if f:subprocess.run(["flex-system-report",f]);QMessageBox.information(self,"FlexOS",f"Rapor:\n{f}")

app=QApplication(sys.argv);app.setStyleSheet(QSS);w=C();w.show();sys.exit(app.exec())

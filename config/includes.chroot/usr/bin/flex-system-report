#!/usr/bin/env python3
import sys,time,zipfile
from pathlib import Path
sys.path.insert(0,"/usr/lib/flexos")
from flexsuite import report_text
d=Path(sys.argv[1]) if len(sys.argv)>1 else Path.home()/"Desktop"/f"FlexOS-System-Report-{time.strftime('%Y%m%d-%H%M%S')}.zip"
d.parent.mkdir(parents=True,exist_ok=True)
with zipfile.ZipFile(d,"w",zipfile.ZIP_DEFLATED) as z:z.writestr("report.txt",report_text())
print(d)

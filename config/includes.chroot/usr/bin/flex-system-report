#!/usr/bin/env python3
from __future__ import annotations

import sys
import time
import zipfile
from pathlib import Path

sys.path.insert(0, "/usr/lib/flexos")
from flexsuite import report_text

try:
    from flexcachy import extended_report
except Exception:
    extended_report = lambda: "CachyOS-derived userspace status unavailable."


def default_destination():
    desktop = Path.home() / "Desktop"
    base = desktop if desktop.exists() else Path.home()
    return base / f"FlexOS-System-Report-{time.strftime('%Y%m%d-%H%M%S')}.zip"


def create_report(destination):
    dest = Path(destination).expanduser()
    dest.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(dest, "w", zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("report.txt", report_text() + "\n\n" + extended_report() + "\n")
        for source, name in [
            (Path("/var/log/flexos-admin.log"), "logs/flexos-admin.log"),
            (Path("/var/log/flexos-recovery.log"), "logs/flexos-recovery.log"),
        ]:
            if source.exists() and source.is_file():
                try:
                    archive.write(source, name)
                except PermissionError:
                    pass
    return dest


def cli(destination):
    dest = create_report(destination)
    print(dest)


def gui():
    from PyQt6.QtCore import QProcess, QThread, Qt, pyqtSignal
    from PyQt6.QtWidgets import (
        QApplication,
        QDialog,
        QFileDialog,
        QHBoxLayout,
        QLabel,
        QMessageBox,
        QProgressBar,
        QVBoxLayout,
    )
    from flexui import apply_theme, button, card, label

    class ReportWorker(QThread):
        ready = pyqtSignal(str)
        failed = pyqtSignal(str)

        def __init__(self, destination, parent=None):
            super().__init__(parent)
            self.destination = destination

        def run(self):
            try:
                self.ready.emit(str(create_report(self.destination)))
            except Exception as exc:
                self.failed.emit(str(exc))

    class ReportDialog(QDialog):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("Flex Sistem Raporu")
            self.resize(650, 390)
            self.setMinimumSize(560, 340)
            self.destination = default_destination()
            self.worker = None

            layout = QVBoxLayout(self)
            layout.setContentsMargins(24, 22, 24, 22)
            layout.setSpacing(12)
            layout.addWidget(label("FLEXOS DIAGNOSTICS", "eyebrow"))
            layout.addWidget(label("Sistem Raporu", "hero"))
            layout.addWidget(label("Donanım, kernel, güvenlik, sürücü ve son sistem uyarılarını tek bir yerel ZIP dosyasında toplayın.", "subtitle"))

            panel, panel_layout = card("Kayıt konumu")
            self.path_label = QLabel(str(self.destination))
            self.path_label.setObjectName("caption")
            self.path_label.setWordWrap(True)
            self.path_label.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
            panel_layout.addWidget(self.path_label)
            panel_layout.addWidget(button("Konum seç", self.choose_destination, "ghost", "document-save-as"))
            layout.addWidget(panel)

            self.progress = QProgressBar()
            self.progress.setRange(0, 1)
            self.progress.setValue(0)
            self.progress.setTextVisible(False)
            layout.addWidget(self.progress)
            self.status = label("Rapor henüz oluşturulmadı.", "caption")
            layout.addWidget(self.status)

            actions = QHBoxLayout()
            actions.addStretch()
            self.open_button = button("Klasörde göster", self.open_folder, "ghost", "folder-open")
            self.open_button.setVisible(False)
            actions.addWidget(self.open_button)
            self.create_button = button("Raporu oluştur", self.start, "primary", "document-save")
            actions.addWidget(self.create_button)
            layout.addLayout(actions)

        def choose_destination(self):
            filename, _ = QFileDialog.getSaveFileName(
                self,
                "Sistem raporunu kaydet",
                str(self.destination),
                "ZIP (*.zip)",
            )
            if filename:
                self.destination = Path(filename)
                if self.destination.suffix.lower() != ".zip":
                    self.destination = self.destination.with_suffix(".zip")
                self.path_label.setText(str(self.destination))
                self.open_button.setVisible(False)
                self.status.setText("Rapor henüz oluşturulmadı.")

        def start(self):
            if self.worker is not None:
                return
            self.create_button.setEnabled(False)
            self.open_button.setVisible(False)
            self.progress.setRange(0, 0)
            self.status.setText("Sistem bilgileri toplanıyor…")
            self.worker = ReportWorker(self.destination, self)
            self.worker.ready.connect(self.completed)
            self.worker.failed.connect(self.failed)
            self.worker.finished.connect(self.worker_finished)
            self.worker.start()

        def worker_finished(self):
            self.worker = None
            self.create_button.setEnabled(True)
            self.progress.setRange(0, 1)

        def completed(self, path):
            self.destination = Path(path)
            self.progress.setRange(0, 1)
            self.progress.setValue(1)
            self.status.setText("Rapor hazır. Dosya yalnızca seçtiğiniz konuma kaydedildi.")
            self.status.setStyleSheet("color:#54d6a0")
            self.open_button.setVisible(True)

        def failed(self, message):
            self.progress.setRange(0, 1)
            self.progress.setValue(0)
            self.status.setText("Rapor oluşturulamadı.")
            self.status.setStyleSheet("color:#ff6b7a")
            QMessageBox.critical(self, "Flex Sistem Raporu", message)

        def open_folder(self):
            QProcess.startDetached("xdg-open", [str(self.destination.parent)])

    app = QApplication(sys.argv)
    app.setApplicationName("Flex Sistem Raporu")
    app.setOrganizationName("FlexOS")
    apply_theme(app)
    dialog = ReportDialog()
    dialog.show()
    return app.exec()


if __name__ == "__main__":
    if len(sys.argv) > 1:
        cli(sys.argv[1])
    else:
        sys.exit(gui())

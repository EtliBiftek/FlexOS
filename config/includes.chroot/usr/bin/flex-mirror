#!/usr/bin/env python3
from __future__ import annotations
import os, re, shutil, subprocess, sys, tempfile, time
from pathlib import Path
from urllib.parse import urlsplit

CANDIDATES=[
    'https://deb.debian.org/debian',
    'https://ftp.de.debian.org/debian',
    'https://ftp.tr.debian.org/debian',
    'https://ftp.nl.debian.org/debian',
]
BACKUP=Path('/var/lib/flexos/mirror-backup')
STATE=Path('/etc/flexos/debian-mirror')

def root():
    if os.geteuid()!=0:raise SystemExit('This action requires root.')

def validate_mirror(value):
    if not isinstance(value,str) or any(ord(ch)<32 or ord(ch)==127 for ch in value):
        raise SystemExit('Invalid Debian mirror URL.')
    value=value.rstrip('/')
    if value not in CANDIDATES:
        raise SystemExit('Mirror is not in the FlexOS Debian mirror allowlist.')
    return value

def is_debian_archive_uri(value):
    try:
        u=urlsplit(value)
    except ValueError:
        return False
    host=(u.hostname or '').lower()
    return (
        u.scheme in {'http','https'} and
        (host=='deb.debian.org' or host.endswith('.debian.org')) and
        u.path.rstrip('/')=='/debian'
    )

def probe(url):
    target=url.rstrip('/')+'/dists/trixie/Release'
    t=time.monotonic()
    p=subprocess.run(
        ['curl','-LfsS','--max-time','8','--range','0-65535','-o','/dev/null',target],
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,
    )
    return (time.monotonic()-t) if p.returncode==0 else 9999.0

def rank():
    rows=sorted((probe(x),x) for x in CANDIDATES)
    for sec,url in rows:print(f'{sec:6.2f}s  {url}' if sec<9999 else f' failed  {url}')
    return rows

def source_files():
    return [
        p for p in [
            Path('/etc/apt/sources.list'),
            *Path('/etc/apt/sources.list.d').glob('*.list'),
            *Path('/etc/apt/sources.list.d').glob('*.sources'),
        ] if p.exists()
    ]

def backup():
    if BACKUP.exists():
        return
    BACKUP.parent.mkdir(parents=True,exist_ok=True)
    tmp=Path(tempfile.mkdtemp(prefix='mirror-backup-',dir=str(BACKUP.parent)))
    try:
        for p in source_files():
            dst=tmp/p.relative_to('/')
            dst.parent.mkdir(parents=True,exist_ok=True)
            shutil.copy2(p,dst)
        os.replace(tmp,BACKUP)
    except Exception:
        shutil.rmtree(tmp,ignore_errors=True)
        raise

def replace_list_text(text,url):
    pattern=re.compile(r'https?://[^\s\]#]+')
    def repl(match):
        old=match.group(0)
        return url if is_debian_archive_uri(old) else old
    return pattern.sub(repl,text)

def replace_sources_text(text,url):
    out=[]
    for stanza in re.split(r'(\n\s*\n)',text):
        if not stanza or stanza.isspace():
            out.append(stanza);continue
        lines=[]
        for line in stanza.splitlines(keepends=True):
            m=re.match(r'^(\s*URIs:\s*)(.*?)(\r?\n)?$',line)
            if not m:
                lines.append(line);continue
            values=m.group(2).split()
            values=[url if is_debian_archive_uri(v) else v for v in values]
            lines.append(m.group(1)+' '.join(values)+(m.group(3) or ''))
        out.append(''.join(lines))
    return ''.join(out)

def transformed(p,text,url):
    return replace_sources_text(text,url) if p.suffix=='.sources' else replace_list_text(text,url)

def apply(url=None):
    root()
    if url is None:
        rows=rank();url=next((u for s,u in rows if s<9999),None)
        if not url:raise SystemExit('No reachable Debian mirror.')
    url=validate_mirror(url)
    backup()
    files=source_files()
    before={p:p.read_bytes() for p in files}
    changed=0
    try:
        for p in files:
            text=before[p].decode('utf-8',errors='surrogateescape')
            new=transformed(p,text,url)
            if new!=text:
                p.write_text(new,encoding='utf-8',errors='surrogateescape')
                changed+=1
        subprocess.run(['apt-get','update'],check=True)
    except Exception as exc:
        for p,data in before.items():
            try:p.write_bytes(data)
            except OSError:pass
        subprocess.run(['apt-get','update'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        raise SystemExit(f'Mirror change failed and was rolled back: {exc}')
    if not changed:print('No Debian mirror URI required changing.')
    STATE.parent.mkdir(parents=True,exist_ok=True)
    STATE.write_text(url+'\n',encoding='utf-8')
    print('Selected mirror:',url)

def restore():
    root()
    if not BACKUP.exists():raise SystemExit('No mirror backup found.')
    for p in BACKUP.rglob('*'):
        if p.is_file():
            dst=Path('/')/p.relative_to(BACKUP)
            dst.parent.mkdir(parents=True,exist_ok=True)
            shutil.copy2(p,dst)
    subprocess.run(['apt-get','update'],check=True)
    STATE.unlink(missing_ok=True)
    print('Original APT mirror files restored.')

def status():
    print('selected:',STATE.read_text().strip() if STATE.exists() else 'system default')

def main():
    a=sys.argv[1:] or ['status']
    if a[0]=='status':status()
    elif a[0]=='rank':rank()
    elif a[0]=='apply':apply(a[1] if len(a)>1 else None)
    elif a[0]=='restore':restore()
    else:raise SystemExit('Usage: flex-mirror status|rank|apply [url]|restore')
if __name__=='__main__':main()

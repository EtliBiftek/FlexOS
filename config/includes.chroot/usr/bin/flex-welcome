#!/usr/bin/env python3
import sys
from pathlib import Path
from PyQt6.QtCore import QProcess
from PyQt6.QtWidgets import QApplication, QLabel, QMainWindow, QPushButton, QVBoxLayout, QWidget, QHBoxLayout

QSS = """
QWidget { background:#111214; color:#d7d9dc; font-size:15px; }
QLabel#hero { font-size:34px; font-weight:700; }
QLabel#muted { color:#8b8f95; }
QPushButton { background:#24272b; border:1px solid #3b3e43; padding:12px 16px; border-radius:9px; text-align:left; }
QPushButton:hover { background:#30343a; }
"""

class Welcome(QMainWindow):
    def __init__(self):
        super().__init__(); self.setWindowTitle("Flex Welcome"); self.resize(720,520)
        w=QWidget(); self.setCentralWidget(w); l=QVBoxLayout(w)
        hero=QLabel("FlexOS'a Hoş Geldiniz"); hero.setObjectName("hero"); l.addWidget(hero)
        m=QLabel("FlexOS'u donanımınıza ve kullanım şeklinize göre ayarlayın."); m.setObjectName("muted"); l.addWidget(m)
        b=QPushButton("⚙  Flex Center\nProfiller, donanım, paketler ve sistem araçları")
        b.clicked.connect(lambda:QProcess.startDetached("flex-center")); l.addWidget(b)
        b=QPushButton("◫  Donanımı kontrol et\nFlex Center'ın donanım sayfasını aç")
        b.clicked.connect(lambda:QProcess.startDetached("flex-center")); l.addWidget(b)
        b=QPushButton("⌁  Dengeli profili etkinleştir")
        b.clicked.connect(lambda:QProcess.startDetached("pkexec",["/usr/bin/flex","profile","set","balanced"])); l.addWidget(b)
        b=QPushButton("⚡  Gaming profili etkinleştir")
        b.clicked.connect(lambda:QProcess.startDetached("pkexec",["/usr/bin/flex","profile","set","gaming"])); l.addWidget(b)
        l.addStretch()
        done=QPushButton("Tamam — bir daha otomatik açma")
        done.clicked.connect(self.finish); l.addWidget(done)

    def finish(self):
        p=Path.home()/".config/flexos/welcome-complete-v1"
        p.parent.mkdir(parents=True,exist_ok=True); p.touch(); self.close()

app=QApplication(sys.argv); app.setStyleSheet(QSS)
w=Welcome(); w.show(); sys.exit(app.exec())

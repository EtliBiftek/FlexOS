#!/usr/bin/env python3
from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

from PyQt6.QtCore import QProcess, QThread, Qt, pyqtSignal
from PyQt6.QtGui import QKeySequence, QShortcut
from PyQt6.QtWidgets import (
    QApplication,
    QCheckBox,
    QComboBox,
    QHBoxLayout,
    QLabel,
    QMainWindow,
    QMessageBox,
    QPlainTextEdit,
    QProgressBar,
    QStackedWidget,
    QTextEdit,
    QVBoxLayout,
    QWidget,
)

sys.path.insert(0, "/usr/lib/flexos")
from flexlib import FLEX_PROFILES, package_profiles
from flexsuite import app_catalog, hardware_text, recommendations
from flexui import apply_theme, button, card, label

MARK = Path.home() / ".config/flexos/welcome-complete"
WALLPAPER = "/usr/share/wallpapers/FlexOS/contents/images/2560x1440.svg"
DESKTOP = Path("/etc/flexos/desktop-profile").read_text(errors="ignore").strip() if Path("/etc/flexos/desktop-profile").exists() else "kde"


class HardwareWorker(QThread):
    ready = pyqtSignal(str)

    def run(self):
        try:
            text = hardware_text()
            tips = recommendations()
            result = text + "\n\nÖNERİLER\n" + "\n".join(f"[{status}] {message}" for status, message in tips)
        except Exception as exc:
            result = f"Donanım bilgisi okunamadı: {exc}"
        self.ready.emit(result)


class Welcome(QMainWindow):
    steps = [
        "Hoş Geldiniz",
        "Donanım",
        "Flex Profile",
        "Paket Profili",
        "Gizlilik & Güvenlik",
        "Uygulamalar",
        "Görünüm",
        "Güncellemeler",
        "Hazır",
    ]

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Flex Welcome")
        self.resize(1080, 720)
        self.setMinimumSize(900, 620)
        self.i = 0
        self.proc = None
        self.queue = []
        self.failed = []
        self.optional_failed = []
        self.hardware_loaded = False
        self.hardware_worker = None

        root = QWidget()
        root.setObjectName("appRoot")
        self.setCentralWidget(root)
        outer = QHBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        rail = QWidget()
        rail.setObjectName("sidebar")
        rail.setFixedWidth(250)
        rail_layout = QVBoxLayout(rail)
        rail_layout.setContentsMargins(18, 22, 18, 18)
        rail_layout.setSpacing(6)

        brand = QHBoxLayout()
        mark = QLabel("F")
        mark.setFixedSize(38, 38)
        mark.setAlignment(Qt.AlignmentFlag.AlignCenter)
        mark.setStyleSheet("background:#7c83ff;color:white;border-radius:11px;font-size:20px;font-weight:800")
        brand.addWidget(mark)
        brand_text = QVBoxLayout()
        brand_text.setSpacing(0)
        brand_text.addWidget(label("Flex Welcome", "brand", False))
        brand_text.addWidget(label("İlk kurulum", "caption", False))
        brand.addLayout(brand_text, 1)
        rail_layout.addLayout(brand)
        rail_layout.addSpacing(16)

        self.labels = []
        for number, step in enumerate(self.steps, 1):
            item = QLabel(f"{number:02d}   {step}")
            self.labels.append(item)
            rail_layout.addWidget(item)
        rail_layout.addStretch()

        desktop_name = {"kde": "KDE Plasma", "gnome": "GNOME", "hyprland": "Hyprland"}.get(DESKTOP, DESKTOP.title())
        footer, footer_layout = card(soft=True)
        footer_layout.setContentsMargins(12, 10, 12, 10)
        footer_layout.addWidget(label("FlexOS Beta", "section"))
        footer_layout.addWidget(label(f"{desktop_name} · Pifo", "caption"))
        rail_layout.addWidget(footer)

        right = QWidget()
        right_layout = QVBoxLayout(right)
        right_layout.setContentsMargins(34, 28, 34, 26)
        right_layout.setSpacing(14)

        self.stack = QStackedWidget()
        for fn in (
            self.page_welcome,
            self.page_hardware,
            self.page_profile,
            self.page_package_profile,
            self.page_security,
            self.page_apps,
            self.page_appearance,
            self.page_updates,
            self.page_finish,
        ):
            self.stack.addWidget(fn())
        right_layout.addWidget(self.stack, 1)

        navigation = QHBoxLayout()
        self.back = button("Geri", self.prev, "ghost", "go-previous")
        navigation.addWidget(self.back)
        navigation.addStretch()
        self.next = button("İleri", self.go, "primary", "go-next")
        navigation.addWidget(self.next)
        right_layout.addLayout(navigation)

        outer.addWidget(rail)
        outer.addWidget(right, 1)

        self.back_shortcut=QShortcut(QKeySequence("Alt+Left"),self)
        self.back_shortcut.activated.connect(self.prev)
        self.apply_shortcut=QShortcut(QKeySequence("Ctrl+Return"),self)
        self.apply_shortcut.activated.connect(self.go)
        self.refresh()

    def base(self, eyebrow, title_text, subtitle):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(12)
        layout.addWidget(label(eyebrow.upper(), "eyebrow"))
        layout.addWidget(label(title_text, "hero"))
        layout.addWidget(label(subtitle, "subtitle"))
        layout.addSpacing(6)
        return widget, layout

    def page_welcome(self):
        desktop_name = {"kde": "KDE Plasma", "gnome": "GNOME", "hyprland": "Hyprland"}.get(DESKTOP, DESKTOP.title())
        widget, layout = self.base("Başlangıç", "FlexOS'a hoş geldiniz", "İlk kullanım ayarlarını birkaç kısa adımda tamamlayın.")
        panel, panel_layout = card("Hazır olduğunuzda başlayın")
        panel_layout.addWidget(
            label(
                f"Bu kurulum {desktop_name} masaüstü profiliyle hazırlandı. Flex Center; güncelleme, sürücü, snapshot, recovery, performans, paket profilleri, gizlilik ve güvenlik araçlarını tek yerde toplar.",
                "caption",
            )
        )
        layout.addWidget(panel)
        warning, warning_layout = card("Beta notu", soft=True)
        warning_layout.addWidget(label("Bu bir beta geliştirme sürümüdür. Önemli verilerin tek kopyasını beta sistem üzerinde tutmayın.", "caption"))
        layout.addWidget(warning)
        layout.addStretch()
        return widget

    def page_hardware(self):
        widget, layout = self.base("Donanım", "Sisteminizi tanıyalım", "FlexOS algılanan donanıma göre ilk önerileri hazırlayacak.")
        panel, panel_layout = card("Donanım özeti")
        self.hardware_box = QPlainTextEdit()
        self.hardware_box.setReadOnly(True)
        self.hardware_box.setPlainText("Donanım bilgisi bu adıma geldiğinizde arka planda okunacak…")
        panel_layout.addWidget(self.hardware_box)
        layout.addWidget(panel, 1)
        return widget

    def page_profile(self):
        widget, layout = self.base("Performans", "Flex Profile", "Güç tüketimi ile performans arasındaki başlangıç tercihinizi seçin.")
        panel, panel_layout = card("Profil seçimi")
        self.prof = QComboBox()
        labels = {
            "balanced": "Balanced — günlük kullanım için önerilen",
            "performance": "Performance — en yüksek performans",
            "gaming": "Gaming — oyun odaklı",
            "battery": "Battery — dizüstü güç tasarrufu",
            "creator": "Creator — render / üretim işleri",
            "minimal": "Minimal — agresif tuning olmadan temel davranış",
        }
        for name in FLEX_PROFILES:
            self.prof.addItem(labels.get(name, name), name)
        self.prof.setCurrentIndex(max(0, self.prof.findData("balanced")))
        panel_layout.addWidget(self.prof)
        panel_layout.addWidget(label("Bu ayar daha sonra Flex Center > Performans bölümünden değiştirilebilir.", "caption"))
        layout.addWidget(panel)
        layout.addStretch()
        return widget

    def page_package_profile(self):
        widget, layout = self.base("Araçlar", "Paket Profili", "Kullanım amacınıza göre ek araç grubunu seçin.")
        panel, panel_layout = card("Hazır paket grubu")
        self.pkgprofile = QComboBox()
        for name, info in package_profiles().items():
            self.pkgprofile.addItem(f"{info.get('name', name)} — {info.get('description', '')}", name)
        self.pkgprofile.setCurrentIndex(max(0, self.pkgprofile.findData("standard")))
        panel_layout.addWidget(self.pkgprofile)
        panel_layout.addWidget(label("Gaming, Geliştirici ve Creator profilleri internet bağlantısı gerektirebilir.", "caption"))
        layout.addWidget(panel)
        layout.addStretch()
        return widget

    def page_security(self):
        widget, layout = self.base("Güvenlik", "Gizlilik & Güvenlik", "Yerel güvenlik varsayımlarını seçin. FlexOS kendi telemetrisini toplamaz.")
        panel, panel_layout = card("Önerilen varsayımlar")
        self.fire = QCheckBox("UFW firewall etkin kalsın · gelen bağlantılar varsayılan engelli")
        self.fire.setChecked(True)
        self.auto = QCheckBox("Otomatik güvenlik güncellemelerini etkinleştir")
        self.auto.setChecked(True)
        self.dumps = QCheckBox("Crash dump dosyalarını diskte kalıcı tutma")
        self.dumps.setChecked(True)
        for item in (self.fire, self.auto, self.dumps):
            panel_layout.addWidget(item)
        panel_layout.addWidget(label("Disk şifreleme, kurulum sırasında Calamares bölümleme ekranından seçilir.", "caption"))
        layout.addWidget(panel)
        layout.addStretch()
        return widget

    def page_apps(self):
        widget, layout = self.base("Uygulamalar", "İsteğe Bağlı Uygulamalar", "İstediğiniz uygulamaları Flathub üzerinden kullanıcı hesabınıza kurun.")
        panel, panel_layout = card("Önerilen uygulamalar")
        self.apps = []
        wanted = {"steam", "discord", "obs", "vscode", "prismlauncher"}
        for app in app_catalog():
            if app["id"] not in wanted:
                continue
            item = QCheckBox(f"{app['name']} — {app['description']}")
            item.setProperty("app", app)
            self.apps.append(item)
            panel_layout.addWidget(item)
        panel_layout.addWidget(label("Bunların hiçbiri FlexOS'un çalışması için zorunlu değildir.", "caption"))
        layout.addWidget(panel)
        layout.addStretch()
        return widget

    def page_appearance(self):
        desktop_name = {"kde": "KDE Plasma", "gnome": "GNOME", "hyprland": "Hyprland"}.get(DESKTOP, DESKTOP.title())
        widget, layout = self.base("Görünüm", "Masaüstü görünümü", f"{desktop_name} için FlexOS koyu görünüm tercihini uygulayın.")
        panel, panel_layout = card("Tema")
        self.dark = QCheckBox("FlexOS koyu görünümünü ve varsayılan duvar kağıdını uygula")
        self.dark.setChecked(True)
        panel_layout.addWidget(self.dark)
        if DESKTOP == "hyprland":
            panel_layout.addWidget(label("Hyprland görünümü seçilen Hyprdots profili tarafından yönetilir; bu adım mevcut yapılandırmayı bozmaz.", "caption"))
        layout.addWidget(panel)
        layout.addStretch()
        return widget

    def page_updates(self):
        widget, layout = self.base("Güncelleme", "İlk güncellemeler", "İlk kullanım öncesi paket indeksini ve FlexOS bileşen kanalını kontrol edin.")
        panel, panel_layout = card("Başlangıç kontrolü")
        self.apt = QCheckBox("APT paket indeksini yenile")
        self.apt.setChecked(True)
        self.components = QCheckBox("FlexOS bileşen güncellemesi olup olmadığını kontrol et")
        self.components.setChecked(True)
        panel_layout.addWidget(self.apt)
        panel_layout.addWidget(self.components)
        panel_layout.addWidget(label("Bulunan FlexOS bileşen güncellemeleri otomatik yüklenmez; Flex Center'da onaylanır.", "caption"))
        layout.addWidget(panel)
        layout.addStretch()
        return widget

    def page_finish(self):
        widget, layout = self.base("Son adım", "Hazır", "Seçimlerinizi kontrol edin ve uygulamayı başlatın.")
        summary, summary_layout = card("Seçim özeti")
        self.sum = QLabel()
        self.sum.setWordWrap(True)
        summary_layout.addWidget(self.sum)
        layout.addWidget(summary)

        progress_card, progress_layout = card("Uygulama durumu", soft=True)
        self.progress = QProgressBar()
        self.progress.setRange(0, 1)
        self.progress.setValue(0)
        progress_layout.addWidget(self.progress)
        self.status = label("Uygulamaya hazır.", "caption")
        progress_layout.addWidget(self.status)
        self.applylog = QTextEdit()
        self.applylog.setReadOnly(True)
        self.applylog.setPlaceholderText("İşlem çıktısı burada görünecek…")
        progress_layout.addWidget(self.applylog, 1)
        layout.addWidget(progress_card, 1)
        return widget

    def load_hardware(self):
        if self.hardware_loaded or self.hardware_worker is not None:
            return
        self.hardware_box.setPlainText("Donanım taranıyor…")
        self.hardware_worker = HardwareWorker(self)
        self.hardware_worker.ready.connect(self.hardware_ready)
        self.hardware_worker.finished.connect(self.hardware_finished)
        self.hardware_worker.start()

    def hardware_ready(self, text):
        self.hardware_loaded = True
        self.hardware_box.setPlainText(text)

    def hardware_finished(self):
        self.hardware_worker = None

    def refresh(self):
        running = self.proc and self.proc.state() != QProcess.ProcessState.NotRunning
        self.stack.setCurrentIndex(self.i)
        self.back.setEnabled(self.i > 0 and not self.queue and not running)
        self.next.setText("Uygula ve Başla" if self.i == len(self.steps) - 1 else "İleri")
        for index, item in enumerate(self.labels):
            item.setObjectName("active" if index == self.i else "step")
            item.style().unpolish(item)
            item.style().polish(item)
        if self.i == 1:
            self.load_hardware()
        if self.i == len(self.steps) - 1:
            selected = [item.property("app")["name"] for item in self.apps if item.isChecked()]
            self.sum.setText(
                f"<b>Flex Profile:</b> {self.prof.currentData()}<br>"
                f"<b>Paket Profili:</b> {self.pkgprofile.currentData()}<br>"
                f"<b>Firewall:</b> {'Açık' if self.fire.isChecked() else 'Kapalı'}<br>"
                f"<b>Security updates:</b> {'Açık' if self.auto.isChecked() else 'Kapalı'}<br>"
                f"<b>Uygulamalar:</b> {', '.join(selected) if selected else 'Ek uygulama yok'}"
            )

    def prev(self):
        running = self.proc and self.proc.state() != QProcess.ProcessState.NotRunning
        if self.queue or running:
            return
        self.i = max(0, self.i - 1)
        self.refresh()

    def go(self):
        running = self.proc and self.proc.state() != QProcess.ProcessState.NotRunning
        if self.queue or running:
            return
        if self.i < len(self.steps) - 1:
            self.i += 1
            self.refresh()
            return
        self.start_apply()

    def start_apply(self):
        self.failed = []
        self.optional_failed = []
        self.applylog.clear()
        self.queue = [
            (["pkexec", "/usr/bin/flex", "profile", "set", self.prof.currentData()], "Flex Profile", True),
            (["pkexec", "/usr/lib/flexos/flex-package-profile-install", "--strict", self.pkgprofile.currentData()], "Flex Package Profile", False),
            (["pkexec", "/usr/lib/flexos/flex-admin", "security", "firewall", "on" if self.fire.isChecked() else "off"], "Firewall", True),
            (["pkexec", "/usr/lib/flexos/flex-admin", "security", "autoupdates", "on" if self.auto.isChecked() else "off"], "Security updates", True),
            (["pkexec", "/usr/lib/flexos/flex-admin", "security", "coredumps", "off" if self.dumps.isChecked() else "on"], "Crash dump policy", False),
        ]
        if self.apt.isChecked():
            self.queue.append((["pkexec", "/usr/lib/flexos/flex-admin", "update", "refresh"], "APT index", False))

        selected_flatpaks = [
            item.property("app")
            for item in self.apps
            if item.isChecked() and item.property("app")["method"] == "flatpak"
        ]
        if selected_flatpaks:
            self.queue.append(
                (["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://flathub.org/repo/flathub.flatpakrepo"], "Flathub", False)
            )
            for app in selected_flatpaks:
                self.queue.append((["flatpak", "install", "--user", "-y", "flathub", app["package"]], app["name"], False))

        self.total = max(1, len(self.queue))
        self.done_count = 0
        self.progress.setRange(0, self.total)
        self.progress.setValue(0)
        self.next.setEnabled(False)
        self.back.setEnabled(False)
        self.run_next()

    def run_next(self):
        if not self.queue:
            self.finish_apply()
            return
        cmd, description, critical = self.queue.pop(0)
        self.current_desc = description
        self.current_critical = critical
        self.status.setText(f"Çalışıyor: {description}")
        self.applylog.append("$ " + " ".join(cmd))
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read_proc)
        self.proc.finished.connect(self.proc_done)
        self.proc.setProgram(cmd[0])
        self.proc.setArguments(cmd[1:])
        self.proc.start()

    def read_proc(self):
        data = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        if data:
            self.applylog.insertPlainText(data)

    def proc_done(self, code, _status):
        self.read_proc()
        if code != 0:
            (self.failed if self.current_critical else self.optional_failed).append(f"{self.current_desc} (kod {code})")
        self.done_count += 1
        self.progress.setValue(self.done_count)
        self.run_next()

    def apply_appearance(self):
        if not self.dark.isChecked():
            return
        if DESKTOP == "kde":
            commands = [
                ["plasma-apply-colorscheme", "BreezeDark"],
                ["plasma-apply-desktoptheme", "breeze-dark"],
                ["plasma-apply-wallpaperimage", WALLPAPER],
            ]
        elif DESKTOP == "gnome":
            wallpaper_uri = f"file://{WALLPAPER}"
            commands = [
                ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark"],
                ["gsettings", "set", "org.gnome.desktop.background", "picture-uri-dark", wallpaper_uri],
            ]
        else:
            commands = []
        for cmd in commands:
            if shutil.which(cmd[0]):
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def finish_apply(self):
        self.apply_appearance()
        if self.components.isChecked():
            try:
                check = subprocess.run(
                    ["/usr/bin/flex-self-update", "check"],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    timeout=30,
                )
                if check.stdout.strip():
                    self.applylog.append("\nFLEXOS COMPONENTS\n" + check.stdout.strip())
                if check.returncode != 0:
                    self.optional_failed.append(f"FlexOS component update check (kod {check.returncode})")
            except Exception as exc:
                self.optional_failed.append(f"FlexOS component update check: {exc}")

        if self.failed:
            self.status.setText("Bazı zorunlu başlangıç ayarları uygulanamadı. Tekrar deneyebilir veya Flex Center'dan düzeltebilirsiniz.")
            self.next.setText("Tekrar Dene")
            self.next.setEnabled(True)
            self.back.setEnabled(True)
            QMessageBox.warning(self, "Flex Welcome", "Tamamlanamayan işlemler:\n- " + "\n- ".join(self.failed))
            return

        MARK.parent.mkdir(parents=True, exist_ok=True)
        MARK.touch()
        self.progress.setValue(self.total)
        message = "İlk FlexOS yapılandırması tamamlandı."
        if self.optional_failed:
            message += "\n\nAtlanan/başarısız isteğe bağlı işlemler:\n- " + "\n- ".join(self.optional_failed)
        self.status.setText(message)
        QMessageBox.information(self, "Flex Welcome", message)
        QProcess.startDetached("flex-center")
        self.close()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Flex Welcome")
    app.setOrganizationName("FlexOS")
    apply_theme(app)
    window = Welcome()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

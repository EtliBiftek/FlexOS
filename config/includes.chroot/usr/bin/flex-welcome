#!/usr/bin/env python3
import sys
from pathlib import Path
from PyQt6.QtCore import QProcess
from PyQt6.QtWidgets import QApplication,QCheckBox,QComboBox,QHBoxLayout,QLabel,QMainWindow,QPushButton,QStackedWidget,QTextEdit,QVBoxLayout,QWidget
sys.path.insert(0,"/usr/lib/flexos")
from flexsuite import hardware_text,recommendations,app_catalog,install_flatpak_user
from flexlib import FLEX_PROFILES
MARK=Path.home()/".config/flexos/welcome-complete-v3"
QSS="""*{font-family:"Noto Sans"}QMainWindow,QWidget{background:#0d0f11;color:#e5e7e9;font-size:14px}QWidget#rail{background:#121417;border-right:1px solid #25292f}
QLabel#hero{font-size:31px;font-weight:700}QLabel#muted{color:#90959c}QLabel#active{font-weight:600;color:#fff;padding:7px}QLabel#step{color:#6f747b;padding:7px}
QPushButton{background:#20242a;border:1px solid #373d45;padding:10px 14px;border-radius:8px}QPushButton#primary{background:#e6e8ea;color:#101214;border:0;font-weight:600}
QTextEdit{background:#101317;border:1px solid #292e35;border-radius:9px}QComboBox{background:#171a1f;border:1px solid #30353d;padding:8px;border-radius:8px}"""
class W(QMainWindow):
    steps=["Hoş Geldiniz","Donanım","Profil","Gizlilik & Güvenlik","Uygulamalar","Güncellemeler","Hazır"]
    def __init__(self):
        super().__init__();self.setWindowTitle("Flex Welcome");self.resize(980,650);self.i=0;self.proc=None;self.queue=[]
        b=QWidget();self.setCentralWidget(b);o=QHBoxLayout(b);o.setContentsMargins(0,0,0,0)
        rail=QWidget();rail.setObjectName("rail");rail.setFixedWidth(225);rl=QVBoxLayout(rail);rl.setContentsMargins(20,22,16,18)
        q=QLabel("F  Flex Welcome");q.setStyleSheet("font-size:23px;font-weight:700");rl.addWidget(q);rl.addSpacing(15);self.labels=[]
        for s in self.steps:q=QLabel(s);self.labels.append(q);rl.addWidget(q)
        rl.addStretch();rl.addWidget(QLabel("FlexOS · KDE Plasma Edition"))
        right=QWidget();r=QVBoxLayout(right);r.setContentsMargins(28,24,28,24);self.stack=QStackedWidget();r.addWidget(self.stack,1)
        for f in (self.p0,self.p1,self.p2,self.p3,self.p4,self.p5,self.p6):self.stack.addWidget(f())
        nav=QHBoxLayout();self.back=QPushButton("Geri");self.back.clicked.connect(self.prev);nav.addWidget(self.back);nav.addStretch();self.next=QPushButton("İleri");self.next.setObjectName("primary");self.next.clicked.connect(self.go);nav.addWidget(self.next);r.addLayout(nav)
        o.addWidget(rail);o.addWidget(right,1);self.refresh()
    def base(self,t,d):
        w=QWidget();l=QVBoxLayout(w);q=QLabel(t);q.setObjectName("hero");l.addWidget(q);q=QLabel(d);q.setObjectName("muted");q.setWordWrap(True);l.addWidget(q);return w,l
    def p0(self):
        w,l=self.base("FlexOS'a hoş geldiniz","KDE Plasma tabanlı FlexOS'u birkaç adımda hazırlayın.");q=QLabel("Flex Center, Update Center, Driver Manager, Snapshot, Recovery, Security ve daha fazlası hazır.");q.setWordWrap(True);l.addWidget(q);l.addStretch();return w
    def p1(self):
        w,l=self.base("Donanımınız","FlexOS'un donanım analizi ve önerileri.");b=QTextEdit();b.setReadOnly(True);b.setPlainText(hardware_text()+"\n\nÖNERİLER\n"+"\n".join(f"[{a}] {b}" for a,b in recommendations()));l.addWidget(b);return w
    def p2(self):
        w,l=self.base("Flex Profile","Başlangıç performans/güç profilini seçin.");self.prof=QComboBox()
        for n in FLEX_PROFILES:self.prof.addItem(n.title(),n)
        self.prof.setCurrentIndex(max(0,self.prof.findData("balanced")));l.addWidget(self.prof);l.addStretch();return w
    def p3(self):
        w,l=self.base("Gizlilik & Güvenlik","İlk güvenlik tercihleri.");self.fire=QCheckBox("Firewall'ı etkinleştir");self.fire.setChecked(True);l.addWidget(self.fire);self.auto=QCheckBox("Otomatik güvenlik güncellemelerini etkinleştir");self.auto.setChecked(True);l.addWidget(self.auto);self.dumps=QCheckBox("Crash dump dosyalarını diskte tutma");self.dumps.setChecked(True);l.addWidget(self.dumps);l.addStretch();return w
    def p4(self):
        w,l=self.base("İsteğe Bağlı Uygulamalar","Flatpak/Flathub üzerinden uygulamalar.");self.apps=[]
        for a in app_catalog():
            if a["id"] not in {"steam","discord","obs","vscode","prismlauncher"}:continue
            q=QCheckBox(f"{a['name']} — {a['description']}");q.setProperty("app",a);self.apps.append(q);l.addWidget(q)
        l.addStretch();return w
    def p5(self):
        w,l=self.base("Güncellemeler","İlk açılışta paket indeksini yenileyebilirsiniz.");self.apt=QCheckBox("APT paket indeksini yenile");self.apt.setChecked(True);l.addWidget(self.apt);l.addStretch();return w
    def p6(self):
        w,l=self.base("Hazır","Seçimler uygulanacak ve Flex Center açılacak.");self.sum=QLabel();self.sum.setWordWrap(True);l.addWidget(self.sum);l.addStretch();return w
    def refresh(self):
        self.stack.setCurrentIndex(self.i);self.back.setEnabled(self.i>0);self.next.setText("Uygula ve Başla" if self.i==len(self.steps)-1 else "İleri")
        for x,q in enumerate(self.labels):q.setObjectName("active" if x==self.i else "step");q.style().unpolish(q);q.style().polish(q)
        if self.i==len(self.steps)-1:self.sum.setText(f"<b>Profile:</b> {self.prof.currentData()}<br><b>Firewall:</b> {'Açık' if self.fire.isChecked() else 'Kapalı'}<br><b>Security updates:</b> {'Açık' if self.auto.isChecked() else 'Kapalı'}")
    def prev(self):self.i=max(0,self.i-1);self.refresh()
    def go(self):
        if self.i<len(self.steps)-1:self.i+=1;self.refresh();return
        self.queue=[["/usr/bin/flex","profile","set",self.prof.currentData()]]
        if self.fire.isChecked():self.queue.append(["/usr/lib/flexos/flex-admin","security","firewall","on"])
        if self.auto.isChecked():self.queue.append(["/usr/lib/flexos/flex-admin","security","autoupdates","on"])
        if self.dumps.isChecked():self.queue.append(["/usr/lib/flexos/flex-admin","security","coredumps","off"])
        if self.apt.isChecked():self.queue.append(["/usr/lib/flexos/flex-admin","update","refresh"])
        self.next.setEnabled(False);self.back.setEnabled(False);self.runq()
    def runq(self):
        if not self.queue:
            for q in self.apps:
                if q.isChecked():install_flatpak_user(q.property("app")["package"])
            MARK.parent.mkdir(parents=True,exist_ok=True);MARK.touch();QProcess.startDetached("flex-center");self.close();return
        c=self.queue.pop(0);self.proc=QProcess(self);self.proc.setProgram("pkexec");self.proc.setArguments(c);self.proc.finished.connect(lambda *_:self.runq());self.proc.start()
app=QApplication(sys.argv);app.setStyleSheet(QSS);w=W();w.show();sys.exit(app.exec())

#!/usr/bin/env python3
from __future__ import annotations
import os,sys
rows=[];page=os.sysconf('SC_PAGE_SIZE')
for name in os.listdir('/proc'):
    if not name.isdigit():continue
    try:
        stat=open(f'/proc/{name}/statm').read().split();rss=int(stat[1])*page;cmd=open(f'/proc/{name}/comm').read().strip();rows.append((rss,int(name),cmd))
    except (OSError,ValueError,IndexError):pass
limit=int(sys.argv[1]) if len(sys.argv)>1 and sys.argv[1].isdigit() else 20
print(f'{"RSS MiB":>10} {"PID":>7} COMMAND')
for rss,pid,cmd in sorted(rows,reverse=True)[:max(1,min(limit,200))]:print(f'{rss/1048576:10.1f} {pid:7d} {cmd}')

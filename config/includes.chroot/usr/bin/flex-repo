#!/usr/bin/env python3
from __future__ import annotations
import json, os, platform, re, subprocess, sys, urllib.request
from pathlib import Path

MAN=Path('/usr/share/flexos/optimized-repos.json');STATE=Path('/etc/flexos/optimized-repo');SRC=Path('/etc/apt/sources.list.d/flexos-optimized.sources')

def root():
    if os.geteuid()!=0:raise SystemExit('This action requires root.')
def flags():
    try:return set(next(x.split(':',1)[1].split() for x in Path('/proc/cpuinfo').read_text(errors='ignore').splitlines() if x.startswith('flags')))
    except Exception:return set()
def level():
    f=flags();v3={'avx','avx2','bmi1','bmi2','f16c','fma','movbe','xsave'};v4={'avx512f','avx512bw','avx512cd','avx512dq','avx512vl'}
    if v3|v4<=f:return 'x86-64-v4'
    if v3<=f:return 'x86-64-v3'
    return 'baseline'
def zen4():
    try:t=Path('/proc/cpuinfo').read_text(errors='ignore').lower();return 'authenticamd' in t and level() in ('x86-64-v3','x86-64-v4') and 'avx512' in t
    except Exception:return False
def compatible(p):
    l=level()
    if p=='baseline':return True
    if p=='x86-64-v3':return l in ('x86-64-v3','x86-64-v4')
    if p=='x86-64-v4':return l=='x86-64-v4'
    if p=='zen4':return zen4()
    return False
def url_for(p):
    d=json.loads(MAN.read_text());spec=d['profiles'][p];return d['base'].format(branch=spec['branch']).rstrip('/')
def healthy(p):
    url=url_for(p)+'/dists/beta/InRelease'
    try:
        req=urllib.request.Request(url,headers={'User-Agent':'FlexOS-repo/1'});r=urllib.request.urlopen(req,timeout=8);return r.status==200 and len(r.read(256))>0
    except Exception:return False
def auto_profile():
    for p in ('zen4','x86-64-v4','x86-64-v3','baseline'):
        if compatible(p) and healthy(p):return p
    return 'baseline'
def select(p):
    root();d=json.loads(MAN.read_text());
    if p=='auto':p=auto_profile()
    if p not in d['profiles']:raise SystemExit('Unknown profile.')
    if not compatible(p):raise SystemExit(f'CPU is not compatible with {p}.')
    STATE.parent.mkdir(parents=True,exist_ok=True)
    if p=='baseline':
        SRC.unlink(missing_ok=True);STATE.write_text('baseline\n');subprocess.run(['apt-get','update']);print('Using baseline Debian/FlexOS repositories.');return
    if not healthy(p):
        print(f'{p} repository is not published/healthy; falling back to baseline without changing APT.')
        SRC.unlink(missing_ok=True);STATE.write_text('baseline\n');return
    base=url_for(p)
    SRC.write_text(f'Types: deb\nURIs: {base}\nSuites: beta\nComponents: main\nSigned-By: /usr/share/keyrings/flexos-archive-keyring.gpg\n')
    STATE.write_text(p+'\n');r=subprocess.run(['apt-get','update'])
    if r.returncode:
        SRC.unlink(missing_ok=True);STATE.write_text('baseline\n');subprocess.run(['apt-get','update']);raise SystemExit('Optimized repository failed APT validation; reverted to baseline.')
    print('Selected:',p)
def status():
    selected=STATE.read_text().strip() if STATE.exists() else 'baseline';print('cpu:',level());print('selected:',selected)
    for p in json.loads(MAN.read_text())['profiles']:
        print(f'{p}: compatible={compatible(p)} published={healthy(p)}')
def main():
    a=sys.argv[1:] or ['status']
    if a[0]=='status':status()
    elif a[0]=='auto':select('auto')
    elif a[0]=='select' and len(a)==2:select(a[1])
    else:raise SystemExit('Usage: flex-repo status|auto|select baseline|x86-64-v3|x86-64-v4|zen4')
if __name__=='__main__':main()

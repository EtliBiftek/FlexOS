#!/usr/bin/env python3
import argparse,json,os,subprocess,sys
sys.path.insert(0,"/usr/lib/flexos")
from flexsuite import *
from flexlib import FLEX_PROFILES,apply_profile,current_profile,identity,doctor
p=argparse.ArgumentParser(prog="flex");s=p.add_subparsers(dest="cmd",required=True)
for n in ("info","doctor","recommend","security","drivers","updates","snapshots","kernel","center","welcome","report"):s.add_parser(n)
h=s.add_parser("hardware");h.add_argument("--json",action="store_true")
pr=s.add_parser("profile");pr.add_argument("action",choices=["list","show","set"]);pr.add_argument("name",nargs="?")
a=p.parse_args()
if a.cmd=="info":
    i=identity();print(f"FlexOS {i.get('version','0.1 Alpha')}\nCreator: Pifo\nDesktop: KDE Plasma\nKernel: {os.uname().release}\nProfile: {current_profile()}")
elif a.cmd=="hardware":print(json.dumps(hardware(),ensure_ascii=False,indent=2) if a.json else hardware_text())
elif a.cmd=="doctor":
    for x,y in doctor():print(f"[{x}] {y}")
elif a.cmd=="recommend":
    for x,y in recommendations():print(f"[{x}] {y}")
elif a.cmd=="security":print(security_status())
elif a.cmd=="drivers":print(driver_status())
elif a.cmd=="updates":print(update_preview())
elif a.cmd=="snapshots":print(snapshot_status())
elif a.cmd=="kernel":print(kernel_status())
elif a.cmd=="profile":
    if a.action=="list":
        for n,v in FLEX_PROFILES.items():print(f"{n:12} {v['description']}")
    elif a.action=="show":print(current_profile())
    else:
        if os.geteuid()!=0:raise SystemExit("Run with sudo.")
        if not a.name:p.error("profile set requires name")
        print(apply_profile(a.name))
elif a.cmd=="center":raise SystemExit(subprocess.run(["flex-center"]).returncode)
elif a.cmd=="welcome":raise SystemExit(subprocess.run(["flex-welcome"]).returncode)
elif a.cmd=="report":raise SystemExit(subprocess.run(["flex-system-report"]).returncode)

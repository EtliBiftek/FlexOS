#!/bin/sh
set -eu

if [ -d /etc/calamares/branding/debian ]; then
  cp -f /usr/share/flexos/calamares/branding/branding.desc /etc/calamares/branding/debian/branding.desc
  cp -f /usr/share/flexos/calamares/branding/flexos-logo.svg /etc/calamares/branding/debian/flexos-logo.svg
  cp -f /usr/share/flexos/calamares/branding/welcome.svg /etc/calamares/branding/debian/welcome.svg
  cp -f /usr/share/flexos/calamares/branding/show.qml /etc/calamares/branding/debian/show.qml
fi
mkdir -p /etc/calamares/modules
cp -f /usr/share/flexos/calamares/modules/packagechooser-flexpackages.conf /etc/calamares/modules/
cp -f /usr/share/flexos/calamares/modules/contextualprocess-flexpackages.conf /etc/calamares/modules/
rm -f /etc/calamares/modules/packagechooser-desktop.conf /etc/calamares/modules/contextualprocess-flexdesktop.conf
rm -f /usr/share/flexos/calamares/modules/packagechooser-desktop.conf /usr/share/flexos/calamares/modules/contextualprocess-flexdesktop.conf

python3 - <<'PY'
from pathlib import Path
p=Path('/etc/calamares/settings.conf')
text=p.read_text()
if 'hide-back-and-next-during-exec:' not in text:
    text += '\nhide-back-and-next-during-exec: false\n'
lines=[x for x in text.splitlines() if 'packagechooser@desktop' not in x and 'contextualprocess@flexdesktop' not in x]
text='\n'.join(lines)+'\n'
instance_items='''  - id: packageprofile
    module: packagechooser
    config: packagechooser-flexpackages.conf
  - id: flexpackages
    module: contextualprocess
    config: contextualprocess-flexpackages.conf
    weight: 4
'''
if 'id: packageprofile' not in text:
    seq=text.find('sequence:')
    if seq < 0: raise SystemExit('Calamares settings.conf has no sequence')
    before,after=text[:seq],text[seq:]
    before=before.rstrip()+'\n'+instance_items+'\n' if 'instances:' in before else before.rstrip()+'\n\ninstances:\n'+instance_items+'\n'
    text=before+after
lines=text.splitlines()
if not any('packagechooser@packageprofile' in x for x in lines):
    for i,line in enumerate(lines):
        if line.strip()=='- partition':
            indent=line[:len(line)-len(line.lstrip())]; lines[i+1:i+1]=[indent+'- packagechooser@packageprofile']; break
if not any('contextualprocess@flexpackages' in x for x in lines):
    inserted=False
    for i,line in enumerate(lines):
        if line.strip()=='- sources-final':
            indent=line[:len(line)-len(line.lstrip())]; lines[i+1:i+1]=[indent+'- contextualprocess@flexpackages']; inserted=True; break
    if not inserted:
        for i,line in enumerate(lines):
            if line.strip()=='- umount':
                indent=line[:len(line)-len(line.lstrip())]; lines[i:i]=[indent+'- contextualprocess@flexpackages']; break
p.write_text('\n'.join(lines).rstrip()+'\n')
PY

rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop /usr/share/applications/calamares-install-debian.desktop
chmod 0755 /usr/bin/flexos-installer /usr/bin/flex /usr/bin/flex-center /usr/bin/flex-welcome
chmod 0755 /usr/lib/flexos/flexos-first-login /usr/lib/flexos/flex-profile-apply /usr/lib/flexos/flex-desktop-install /usr/lib/flexos/flex-package-profile-install

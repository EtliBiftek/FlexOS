#!/bin/sh
set -eu

if [ -d /etc/calamares/branding/debian ]; then
  cp -f /usr/share/flexos/calamares/branding/branding.desc /etc/calamares/branding/debian/branding.desc
  cp -f /usr/share/flexos/calamares/branding/stylesheet.qss /etc/calamares/branding/debian/stylesheet.qss
  cp -f /usr/share/flexos/calamares/branding/flexos-logo.svg /etc/calamares/branding/debian/flexos-logo.svg
  cp -f /usr/share/flexos/calamares/branding/welcome.svg /etc/calamares/branding/debian/welcome.svg
  cp -f /usr/share/flexos/calamares/branding/show.qml /etc/calamares/branding/debian/show.qml
  cp -f /usr/share/flexos/calamares/branding/hyprdots.qml /etc/calamares/branding/debian/hyprdots.qml
fi

mkdir -p /etc/calamares/modules
for f in \
  mount.conf \
  packagechooser-desktop.conf packagechooser-hyprdots.conf packagechooser-flexpackages.conf \
  contextualprocess-flexdesktop.conf contextualprocess-hyprdots.conf contextualprocess-flexpackages.conf \
  shellprocess-flexpostinstall.conf \
  welcome.conf locale.conf keyboard.conf
do
  [ -f "/usr/share/flexos/calamares/modules/$f" ] && cp -f "/usr/share/flexos/calamares/modules/$f" /etc/calamares/modules/
done

if [ ! -f /etc/calamares/modules/mount.conf ] || ! grep -Eq 'subvolume:[[:space:]]*/?@([[:space:]]|$)' /etc/calamares/modules/mount.conf; then
  echo "ERROR: Calamares mount.conf does not define a /@ Btrfs root subvolume." >&2
  exit 1
fi

python3 - <<'PY'
from pathlib import Path
import re
p=Path("/etc/calamares/modules/partition.conf")
if p.exists():
    text=p.read_text()
    rules={
        r'(?m)^\s*defaultFileSystemType:\s*.*$':'defaultFileSystemType: "ext4"',
        r'(?m)^\s*availableFileSystemTypes:\s*.*$':'availableFileSystemTypes: ["ext4","btrfs"]',
        r'(?m)^\s*enableLuksAutomatedPartitioning:\s*.*$':'enableLuksAutomatedPartitioning: true',
        r'(?m)^\s*initialPartitioningChoice:\s*.*$':'initialPartitioningChoice: none',
    }
    for pattern,replacement in rules.items():
        text=re.sub(pattern,replacement,text) if re.search(pattern,text) else text+"\n"+replacement+"\n"
    if not re.search(r'(?m)^availableFileSystemTypes:',text):
        text += '\navailableFileSystemTypes: ["ext4","btrfs"]\n'
    p.write_text(text.rstrip()+"\n")
PY

python3 - <<'PY'
from pathlib import Path

p=Path("/etc/calamares/settings.conf")
text=p.read_text()
if "hide-back-and-next-during-exec:" not in text:
    text += "\nhide-back-and-next-during-exec: false\n"

managed=(
    "packagechooser@desktop","packagechooserq@hyprdots","packagechooser@packageprofile",
    "contextualprocess@flexdesktop","contextualprocess@flexhyprdots",
    "contextualprocess@flexpackages","shellprocess@flexpostinstall",
)
lines=[line for line in text.splitlines() if not any(x in line for x in managed)]
text="\n".join(lines)+"\n"

instances="""  - id: desktop
    module: packagechooser
    config: packagechooser-desktop.conf
  - id: hyprdots
    module: packagechooserq
    config: packagechooser-hyprdots.conf
  - id: packageprofile
    module: packagechooser
    config: packagechooser-flexpackages.conf
  - id: flexdesktop
    module: contextualprocess
    config: contextualprocess-flexdesktop.conf
    weight: 8
  - id: flexhyprdots
    module: contextualprocess
    config: contextualprocess-hyprdots.conf
    weight: 8
  - id: flexpackages
    module: contextualprocess
    config: contextualprocess-flexpackages.conf
    weight: 4
  - id: flexpostinstall
    module: shellprocess
    config: shellprocess-flexpostinstall.conf
    weight: 3
"""

pos=text.find("sequence:")
if pos < 0:
    raise SystemExit("Calamares settings.conf has no sequence")
before,after=text[:pos],text[pos:]
if "instances:" in before:
    before=before.rstrip()+"\n"+instances+"\n"
else:
    before=before.rstrip()+"\n\ninstances:\n"+instances+"\n"
text=before+after
lines=text.splitlines()

def insert_after(token, entries):
    for i,line in enumerate(lines):
        if line.strip()==token:
            indent=line[:len(line)-len(line.lstrip())]
            lines[i+1:i+1]=[indent+e for e in entries]
            return True
    return False

def insert_before(token, entries):
    for i,line in enumerate(lines):
        if line.strip()==token:
            indent=line[:len(line)-len(line.lstrip())]
            lines[i:i]=[indent+e for e in entries]
            return True
    return False

if not insert_after("- keyboard", ["- packagechooser@desktop","- packagechooserq@hyprdots"]):
    insert_before("- partition", ["- packagechooser@desktop","- packagechooserq@hyprdots"])
insert_after("- partition", ["- packagechooser@packageprofile"])

exec_jobs=[
    "- contextualprocess@flexdesktop",
    "- contextualprocess@flexpackages",
    "- contextualprocess@flexhyprdots",
]
# Debian/Calamares configurations are not required to contain a sources-final
# job. KDE can mask this mistake because it is already in the live squashfs,
# while GNOME/Hyprland then never get installed. Prefer sources-final when it
# exists, but always fall back to the last safe point before unmounting target.
if not insert_after("- sources-final", exec_jobs):
    if not insert_before("- umount", exec_jobs):
        raise SystemExit("Calamares exec sequence has no safe insertion point for FlexOS desktop jobs")

if not insert_before("- umount", ["- shellprocess@flexpostinstall"]):
    raise SystemExit("Calamares exec sequence has no umount step for FlexOS post-install")

p.write_text("\n".join(lines).rstrip()+"\n")
PY

rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
rm -f /usr/share/applications/calamares-install-debian.desktop

chmod 0755 /usr/bin/flexos-installer /usr/bin/flex /usr/bin/flex-center /usr/bin/flex-welcome /usr/bin/flex-system-report /usr/bin/flex-self-update /usr/bin/flex-beta-check
chmod 0755 /usr/lib/flexos/flex-postinstall /usr/lib/flexos/flex-recovery-console /usr/lib/flexos/flex-admin /usr/lib/flexos/flexsuite.py
chmod 0755 /usr/lib/flexos/flexos-first-login /usr/lib/flexos/flex-profile-apply /usr/lib/flexos/flex-package-profile-install
chmod 0755 /usr/lib/flexos/flex-desktop-install /usr/lib/flexos/flex-hyprdots-install
chmod 0755 /etc/grub.d/41_flexos_recovery

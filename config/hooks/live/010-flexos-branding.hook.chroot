#!/bin/sh
set -eu

printf 'flexos\n' > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1 localhost
127.0.1.1 flexos
::1 localhost ip6-localhost ip6-loopback
EOF

# Applications generally read /usr/lib/os-release; keep it identical.
cp /etc/os-release /usr/lib/os-release

# Keep update-alternatives and icon caches sane where available.
command -v update-icon-caches >/dev/null 2>&1 && update-icon-caches /usr/share/icons/hicolor || true
